@using global::Tests
<MudPaper Class="pa-4" Elevation="2">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                           Size="Size.Small"
                           OnClick="@(() => _expanded = !_expanded)" />
            <MudText Typo="Typo.subtitle1">@Test.Title</MudText>
        </MudStack>
        <MudCollapse Expanded="_expanded">
            <PayloadForm Payload="Test.Payload" PayloadChanged="val => Test.Payload = val"/>
        </MudCollapse>
        <OperationView @ref="_operationView" Name="Process" StartCallback="Test.Start"/>
    </MudStack>
</MudPaper>

@code {

    [Parameter]
    public required IClusterTest Test { get; set; }

    private bool _expanded;
    private OperationView _operationView = null!;

    public Task Run() => _operationView.Run();

}
