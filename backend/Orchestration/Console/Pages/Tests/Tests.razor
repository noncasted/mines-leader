@page "/tests"
@using global::Common.Extensions
@using global::Tests

<PageTitle>Tests</PageTitle>
<PageHeader Title="Tests"/>

<MudContainer MaxWidth="MaxWidth.Medium" Class="px-4 py-4">
    <MudStack Spacing="4">
        <TestEntry
            Title="Messaging direct queue"
            @bind-Payload="_messagingDirectQueueStressTestPayload"
            StartCallback="Run_Messaging_DirectQueue"/>

        <TestEntry
            Title="Messaging transactional queue"
            @bind-Payload="_messagingTransactionalQueueStressTest"
            StartCallback="Run_Messaging_TransactionalQueue"/>

        <TestEntry
            Title="Messaging pipe send (one-way)"
            @bind-Payload="_messagePipeSendStressTestPayload"
            StartCallback="Run_MessagePipe_Send"/>

        <TestEntry
            Title="Messaging pipe send with response (request-response)"
            @bind-Payload="_messagePipeSendResponseStressTestPayload"
            StartCallback="Run_MessagePipe_SendResponse"/>
    </MudStack>
</MudContainer>

@code {
    [Inject] public MessagingDirectQueueStressTest.Root MessagingDirectQueueStressTest { get; set; }
    [Inject] public MessagingTransactionalQueueStressTest.Root MessagingTransactionalQueueStressTest { get; set; }
    [Inject] public MessagePipeSendStressTest.Root MessagePipeSendStressTest { get; set; }
    [Inject] public MessagePipeSendResponseStressTest.Root MessagePipeSendResponseStressTest { get; set; }
    
    private MessagingDirectQueueStressTest.StartPayload _messagingDirectQueueStressTestPayload = new()
    {
        MessageCount = 100,
        Delay = 0.01f
    };

    private MessagingTransactionalQueueStressTest.StartPayload _messagingTransactionalQueueStressTest = new()
    {
        MessageCount = 1,
        Delay = 0.01f
    };

    private MessagePipeSendStressTest.StartPayload _messagePipeSendStressTestPayload = new()
    {
        MessageCount = 100,
        Delay = 0.01f
    };

    private MessagePipeSendResponseStressTest.StartPayload _messagePipeSendResponseStressTestPayload = new()
    {
        MessageCount = 10,
        Delay = 0.01f
    };

    private Task Run_Messaging_DirectQueue(IOperationProgress progress)
    {
        return MessagingDirectQueueStressTest.Start(progress, _messagingDirectQueueStressTestPayload);
    }

    private Task Run_Messaging_TransactionalQueue(IOperationProgress progress)
    {
        return MessagingTransactionalQueueStressTest.Start(progress, _messagingTransactionalQueueStressTest);
    }

    private Task Run_MessagePipe_Send(IOperationProgress progress)
    {
        return MessagePipeSendStressTest.Start(progress, _messagePipeSendStressTestPayload);
    }

    private Task Run_MessagePipe_SendResponse(IOperationProgress progress)
    {
        return MessagePipeSendResponseStressTest.Start(progress, _messagePipeSendResponseStressTestPayload);
    }

}