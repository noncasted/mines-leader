@page "/tests"
@using global::Tests

<PageTitle>Tests</PageTitle>
<PageHeader Title="Tests"/>

<MudContainer MaxWidth="MaxWidth.Medium" Class="px-4 py-4">
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var group in ClusterTests.GroupBy(t => t.Group))
        {
            var groupTests = group.ToList();
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center justify-space-between" style="width: 100%">
                        <MudText>@group.Key</MudText>
                        <div @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => RunGroup(groupTests))">
                                Run All
                            </MudButton>
                        </div>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="4" Class="pt-2">
                        @foreach (var test in groupTests)
                        {
                            <TestEntry @ref="_entries[test]" Test="test"/>
                        }
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</MudContainer>

@code {
    [Inject] public IEnumerable<IClusterTest> ClusterTests { get; set; } = [];

    private readonly Dictionary<IClusterTest, TestEntry?> _entries = new();

    protected override void OnParametersSet()
    {
        foreach (var test in ClusterTests)
            _entries.TryAdd(test, null);
    }

    private async Task RunGroup(List<IClusterTest> tests)
    {
        foreach (var test in tests)
        {
            if (_entries.TryGetValue(test, out var entry) && entry != null)
                await entry.Run();
        }
    }
}
