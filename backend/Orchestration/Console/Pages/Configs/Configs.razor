@page "/configs"
@using Shared
@using Cluster.Configs
@using global::Common.Extensions

<PageTitle>Configs</PageTitle>
<PageHeader Title="Configurations"/>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6" Class="mb-2">
            Bot Configuration
        </MudText>

        <MudStack Row="true" Spacing="2">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Primary"
                OnClick="Reload">
                Reload
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Success"
                OnClick="Save">
                Save
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Info"
                OnClick="UpdateJson"
                Disabled="_isUpdatingJson">
                Update json
            </MudButton>
        </MudStack>

        <BotConfigEditor Value="_botValue"/>

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.h6" Class="mb-2">
            Card Configurations
        </MudText>

        <MudGrid Spacing="3">
            @foreach (var (cardType, config) in _cardsValue.All)
            {
                if (config is ICardSizeConfig sizeConfig)
                {
                    <MudItem xs="12" sm="6">
                        <CardConfigEditor
                            @key="cardType"
                            Value="config"
                            SizeConfig="sizeConfig"
                            Type="cardType"/>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <CardConfigEditor
                            @key="cardType"
                            Value="config"
                            Type="cardType"/>
                    </MudItem>
                }
            }
        </MudGrid>
    </MudStack>
</MudContainer>

@code {

    [Inject]
    public ICardConfigs CardConfigs { get; set; } = null!;

    [Inject]
    public IBotConfig BotConfig { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    private CardConfigOptions _cardsValue = new();
    private BotConfigOptions _botValue = new();
    private bool _isUpdatingJson;

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        ReloadField(CardConfigs.Value, ref _cardsValue);
        ReloadField(BotConfig.Value, ref _botValue);

        InvokeAsync(StateHasChanged);

        return;

        void ReloadField<T>(T current, ref T field)
        {
            var raw = JsonUtils.Serialize(current!);
            field = JsonUtils.Deserialize<T>(raw);
        }
    }

    private void Save()
    {
        CardConfigs.SetValue(_cardsValue);
        BotConfig.SetValue(_botValue);
    }

    private async Task UpdateJson()
    {
        _isUpdatingJson = true;

        try
        {
            var cardsValue = JsonUtils.Serialize(_cardsValue);
            var botValue = JsonUtils.Serialize(_botValue);

            var projectRoot = AppContext.BaseDirectory;
            var targetFolder = Path.Combine(projectRoot, "..", "..", "..", "..", "Coordinator");
            var cardsPath = Path.Combine(targetFolder, "config.cards.json");
            var botPath = Path.Combine(targetFolder, "config.bot.json");

            var cardsFullPath = Path.GetFullPath(cardsPath);
            var botFullPath = Path.GetFullPath(botPath);

            await File.WriteAllTextAsync(cardsFullPath, cardsValue);
            await File.WriteAllTextAsync(botFullPath, botValue);

            Snackbar.Add($"Configs saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingJson = false;
        }
    }

}
