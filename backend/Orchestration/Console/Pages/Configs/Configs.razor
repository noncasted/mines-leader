@page "/configs"
@using Shared
@using Cluster.Configs
@using global::Common.Extensions

<PageTitle>Configs</PageTitle>
<PageHeader Title="Configurations"/>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6" Class="mb-2">
            Bot Configuration
        </MudText>

        <MudStack Row="true" Spacing="2">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Primary"
                OnClick="Reload">
                Reload
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Success"
                OnClick="Save">
                Write
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Info"
                OnClick="UpdateJson"
                Disabled="_isUpdatingJson">
                Update json
            </MudButton>
        </MudStack>

        <BotConfigEditor Value="_botValue"/>

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.h6" Class="mb-2">
            Game Mode Configuration
        </MudText>

        <GameModeConfigEditor Value="_gameModeValue"/>

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.h6" Class="mb-2">
            CardUse Configurations
        </MudText>

        <MudGrid Spacing="3">
            @foreach (var (cardType, config) in _cardsValue.All)
            {
                if (config is ICardSizeConfig sizeConfig)
                {
                    <MudItem xs="12" sm="6">
                        <CardConfigEditor
                            @key="cardType"
                            Value="config"
                            SizeConfig="sizeConfig"
                            Type="cardType"/>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <CardConfigEditor
                            @key="cardType"
                            Value="config"
                            Type="cardType"/>
                    </MudItem>
                }
            }
        </MudGrid>
    </MudStack>
</MudContainer>

@code {

    [Inject]
    public ICardConfigs CardConfigs { get; set; } = null!;

    [Inject]
    public IBotConfig BotConfig { get; set; } = null!;

    [Inject]
    public IGameModeConfig GameModeConfig { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    private CardConfigOptions _cardsValue = new();
    private BotConfigOptions _botValue = new();
    private GameModeOptions _gameModeValue = new();
    private bool _isUpdatingJson;

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        ReloadField(CardConfigs.Value, ref _cardsValue);
        ReloadField(BotConfig.Value, ref _botValue);
        ReloadField(GameModeConfig.Value, ref _gameModeValue);

        InvokeAsync(StateHasChanged);

        return;

        void ReloadField<T>(T current, ref T field)
        {
            var raw = JsonUtils.Serialize(current!);
            field = JsonUtils.Deserialize<T>(raw);
        }
    }

    private void Save()
    {
        CardConfigs.SetValue(_cardsValue);
        BotConfig.SetValue(_botValue);
        GameModeConfig.SetValue(_gameModeValue);
    }

    private async Task UpdateJson()
    {
        _isUpdatingJson = true;

        var coordinatorFolder = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "Coordinator");

        try
        {

            await SaveConfig("config.cards", _cardsValue);
            await SaveConfig("config.bot", _botValue);
            await SaveConfig("config.gameMode", _gameModeValue);

            Snackbar.Add($"Configs saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingJson = false;
        }

        return;

        async Task SaveConfig<T>(string jsonPath, T value)
        {
            var configPath = Path.Combine(coordinatorFolder, $"{jsonPath}.json");
            var fullPath = Path.GetFullPath(configPath);
            var json = JsonUtils.Serialize(value)!;
            await File.WriteAllTextAsync(fullPath, json);
        }
    }

}
