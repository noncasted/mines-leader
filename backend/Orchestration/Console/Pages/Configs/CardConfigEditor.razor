@using Shared
@using global::Common.Extensions

<MudCard Class="mb-3">
    <MudCardContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle1">
                    @Name
                </MudText>
            </MudItem>

            @if (SizeConfig != null)
            {
                <MudItem xs="12" sm="3">
                    <MudTextField
                        Label="Size"
                        @bind-Value="SizeConfig.Size"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>
            }

            <MudItem xs="12" sm="3">
                <MudTextField
                    Label="ManaCost"
                    @bind-Value="Value.ManaCost"
                    InputType="InputType.Number"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"/>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {

    [Parameter]
    public ICardConfig Value { get; set; } = null!;

    [Parameter]
    public ICardSizeConfig? SizeConfig { get; set; }

    [Parameter]
    public CardType Type { get; set; }

    private string Name => Type.ToString();
}
