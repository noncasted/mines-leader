@using Shared

<MudStack Spacing="3">
    <MudText Typo="Typo.h6" Class="mb-2">
        Last Man Standing
    </MudText>

    <MudCard Class="mb-3">
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Health"
                        @bind-Value="Value.LastManStanding.PlayerHealth"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Moves"
                        @bind-Value="Value.LastManStanding.PlayerMoves"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Start Mana"
                        @bind-Value="Value.LastManStanding.PlayerStartMana"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Hand Size"
                        @bind-Value="Value.LastManStanding.HandSize"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Deck Size"
                        @bind-Value="Value.LastManStanding.DeckSize"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Round Time (seconds)"
                        @bind-Value="Value.LastManStanding.RoundTime"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudDivider Class="my-4"/>

    <MudText Typo="Typo.h6" Class="mb-2">
        Time Limited
    </MudText>

    <MudCard Class="mb-3">
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Health"
                        @bind-Value="Value.TimeLimited.PlayerHealth"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Moves"
                        @bind-Value="Value.TimeLimited.PlayerMoves"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Player Start Mana"
                        @bind-Value="Value.TimeLimited.PlayerStartMana"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Hand Size"
                        @bind-Value="Value.TimeLimited.HandSize"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Deck Size"
                        @bind-Value="Value.TimeLimited.DeckSize"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Round Time (seconds)"
                        @bind-Value="Value.TimeLimited.RoundTime"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField
                        Label="Time Gain Per Action (seconds)"
                        @bind-Value="Value.TimeLimited.TimeGainPerAction"
                        InputType="InputType.Number"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"/>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</MudStack>

@code {
    [Parameter]
    public GameModeOptions Value { get; set; } = null!;
}
