@page "/bots"
@using global::Common.Extensions
@using global::Common.Reactive
@using Infrastructure.State
@using Meta.Bots
@using Meta.Users
@implements IDisposable

<PageTitle>Bots</PageTitle>
<PageHeader Title="Bot Management"/>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <MudStack Spacing="3">
        @if (!_showCreateForm)
        {
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Primary"
                OnClick="@ToggleCreateForm">
                ProcessBuilder Bot
            </MudButton>
        }
        else
        {
            <MudCard>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">ProcessBuilder New Bot</MudText>
                        <MudTextField
                            @bind-Value="_newBotName"
                            Label="Bot Name"
                            Placeholder="Enter bot name"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"/>
                        <MudStack Row="true" Spacing="2">
                            <MudButton
                                Variant="Variant.Filled"
                                Color="Color.Primary"
                                OnClick="@SubmitCreateBot"
                                Disabled="@string.IsNullOrWhiteSpace(_newBotName)">
                                ProcessBuilder
                            </MudButton>
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Default"
                                OnClick="@ToggleCreateForm">
                                Cancel
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        <MudTable Items="_bots" Hover="true"
                  OnRowClick="@((TableRowClickEventArgs<BotState> args) => HandleRowClick(args))">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>ID</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@_names[context.Id]</MudTd>
                <MudTd>@context.Id</MudTd>
                <MudTd @onclick:stopPropagation="true">
                    <MudIconButton
                        Icon="@Icons.Material.Filled.Edit"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@((e) => NavigateToBotEditor(context.Id))"/>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
</MudContainer>

@code {

    [Inject]
    public IBotCollection BotCollection { get; set; } = null!;

    [Inject]
    public IBotFactory BotFactory { get; set; } = null!;

    [Inject]
    public IStateStorage Storage { get; set; } = null!;

    [Inject]
    public NavigationManager Navigation { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    private List<BotState> _bots = new();
    private bool _showCreateForm = false;
    private string _newBotName = string.Empty;

    private readonly Dictionary<Guid, string> _names = new();
    private readonly Lifetime _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadBots();

        BotCollection.Updated.Advise(_lifetime, () => ReloadBots().NoAwait());
    }

    private async Task ReloadBots()
    {
        if (BotCollection.Values.Any() == false)
            return;

        var stateIdentities = new List<StateIdentity>();
        var stateInfo = Storage.Registry.Get<UserState>();

        foreach (var botState in BotCollection.Values)
        {
            var identity = new StateIdentity
            {
                Key = botState.Id,
                Type = stateInfo.Name,
                Extension = null,
                TableName = stateInfo.TableName
            };

            stateIdentities.Add(identity);
        }

        var botUsers = await Storage.Read<Guid, UserState>(stateIdentities);

        foreach (var (id, userState) in botUsers)
            _names[id] = userState.Name;

        _bots = BotCollection.Values.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        if (!_showCreateForm)
        {
            _newBotName = string.Empty;
        }
    }

    private async Task SubmitCreateBot()
    {
        if (string.IsNullOrWhiteSpace(_newBotName))
        {
            Snackbar.Add("Bot name cannot be empty", Severity.Warning);
            return;
        }

        try
        {
            await BotFactory.Create(_newBotName);
            Snackbar.Add($"Bot '{_newBotName}' created successfully", Severity.Success);
            _showCreateForm = false;
            _newBotName = string.Empty;
            ReloadBots();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating bot: {ex.Message}", Severity.Error);
            throw;
        }
    }

    private void HandleRowClick(TableRowClickEventArgs<BotState> args)
    {
        NavigateToBotEditor(args.Item.Id);
    }

    private void NavigateToBotEditor(Guid botId)
    {
        Navigation.NavigateTo($"/bots/{botId}");
    }

    public void Dispose()
    {
        Snackbar.Dispose();
        _lifetime.Terminate();
    }

}
