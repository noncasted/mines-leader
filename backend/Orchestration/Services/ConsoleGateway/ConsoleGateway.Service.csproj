<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The separate service of the ConsoleGateway role: its host (ConsoleGateway/) alone in the process. The assembly
         keeps the name of the role: the Dockerfile and the compose start it as ConsoleGateway.dll. -->
    <PropertyGroup>
        <AssemblyName>ConsoleGateway</AssemblyName>
        <RootNamespace>ConsoleGateway.Service</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ConsoleGateway\ConsoleGateway.csproj"/>
    </ItemGroup>

    <!-- The static files of a Razor class library reach the manifest of the exe only from a direct reference
         (DisableTransitiveProjectReferences): the console pages of the framework and of the game. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\Console\Console.csproj"/>
        <ProjectReference Include="..\..\..\..\tools\framework\backend\Console\Console.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Card icons served at /card-icons in the console UI. Copied into the build/publish output so they are
             available both locally and in the container image (the docs/ folder itself is not shipped; see the
             matching exception in the root .dockerignore). A copy per console exe: content does not flow through a
             ProjectReference. -->
        <Content Include="..\..\..\..\docs\obsidian\game\cards\icons\*.png"
                 LinkBase="card-icons"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
