<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The separate service of the Silo role: its host (Silo/) alone in the process. The assembly keeps the name
         of the role: the Dockerfile and the compose start it as Silo.dll. -->
    <PropertyGroup>
        <AssemblyName>Silo</AssemblyName>
        <RootNamespace>Silo.Service</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Silo\Silo.csproj"/>
    </ItemGroup>

</Project>
