<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The separate service of the Coordinator role: its host (Coordinator/) alone in the process. The assembly keeps the name
         of the role: the Dockerfile and the compose start it as Coordinator.dll. -->
    <PropertyGroup>
        <AssemblyName>Coordinator</AssemblyName>
        <RootNamespace>Coordinator.Service</RootNamespace>
    </PropertyGroup>

    <!-- The cluster configs (ConfigsInitializer), read from the content root of the coordinator host: this folder under
         Aspire (dotnet run), /app in a container (the publish output); a monolith links them into hosts/Coordinator.
         A missing file throws. The Web SDK includes them as Content; the copies are set here. -->
    <ItemGroup>
        <Content Update="config.*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Coordinator\Coordinator.csproj"/>
    </ItemGroup>

</Project>
