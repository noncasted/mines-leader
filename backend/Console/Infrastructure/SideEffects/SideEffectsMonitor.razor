@page "/side-effects"
@using Cluster.Deploy
@using Cluster.Monitoring
@using global::Common.Extensions
@using global::Common.Reactive
@using global::Infrastructure
@inherits UiComponent

<PageTitle>Side Effects Monitor</PageTitle>
<PageHeader Title="Side Effects Monitor"/>

<div class="container mx-auto max-w-5xl px-4 py-4 flex flex-col gap-6">

    <div class="grid grid-cols-4 gap-4">
        <div class="rounded-lg border bg-card p-5 flex flex-col items-center gap-2">
            <div class="flex items-center gap-2">
                <div class="rounded-md bg-blue-500/15 p-1.5">
                    <LucideIcon Name="inbox" Size="14" class="text-blue-400"/>
                </div>
                <span class="text-sm font-medium text-muted-foreground">Queue</span>
            </div>
            <span class="text-3xl font-bold">@_data.QueueCount</span>
            <span class="text-xs text-muted-foreground">Pending effects</span>
        </div>

        <div class="rounded-lg border bg-card p-5 flex flex-col items-center gap-2">
            <div class="flex items-center gap-2">
                <div class="rounded-md bg-orange-500/15 p-1.5">
                    <LucideIcon Name="loader" Size="14" class="text-orange-400"/>
                </div>
                <span class="text-sm font-medium text-muted-foreground">Processing</span>
            </div>
            <span class="text-3xl font-bold">@_data.ProcessingCount</span>
            <span class="text-xs text-muted-foreground">In-flight effects</span>
        </div>

        <div class="rounded-lg border bg-card p-5 flex flex-col items-center gap-2">
            <div class="flex items-center gap-2">
                <div class="rounded-md bg-red-500/15 p-1.5">
                    <LucideIcon Name="alert-triangle" Size="14" class="text-red-400"/>
                </div>
                <span class="text-sm font-medium text-muted-foreground">Retry</span>
            </div>
            <span class="text-3xl font-bold">@_data.RetryCount</span>
            <span class="text-xs text-muted-foreground">Failed effects awaiting retry</span>
        </div>

        <div class="rounded-lg border bg-card p-5 flex flex-col items-center gap-2">
            <div class="flex items-center gap-2">
                <div class="rounded-md bg-purple-500/15 p-1.5">
                    <LucideIcon Name="skull" Size="14" class="text-purple-400"/>
                </div>
                <span class="text-sm font-medium text-muted-foreground">Dead Letter</span>
            </div>
            <span class="text-3xl font-bold @(_data.DeadLetterCount > 0 ? "text-destructive" : "")">@_data.DeadLetterCount</span>
            <span class="text-xs text-muted-foreground">Permanently failed effects</span>
        </div>
    </div>

    <div class="rounded-lg border bg-card p-5 flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="rounded-md bg-green-500/15 p-1.5">
                    <LucideIcon Name="activity" Size="14" class="text-green-400"/>
                </div>
                <span class="text-sm font-medium text-muted-foreground">Throughput</span>
            </div>
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                @if (_data.ThroughputHistory.Count > 0)
                {
                    var last = _data.ThroughputHistory[^1];
                    var peakVal = _data.ThroughputHistory.Max(d => d.Processed);
                    <span>
                        <span class="text-green-400 font-medium">@last.Processed</span>/s processed
                    </span>
                    @if (last.Failed > 0)
                    {
                        <span>
                            <span class="text-red-400 font-medium">@last.Failed</span>/s failed
                        </span>
                    }
                    <span>peak @peakVal/s</span>
                }
            </div>
        </div>

        <BbAreaChart Data="@_chartData" Height="200px">
            <BbXAxis DataKey="key"/>
            <BbYAxis ShowGrid="false"/>
            <BbChartTooltip/>
            <BbArea DataKey="processed" Name="Processed" Color="var(--chart-2)" Curve="CurveType.Smooth"/>
            <BbArea DataKey="failed" Name="Failed" Color="var(--chart-5)" Curve="CurveType.Smooth"/>
        </BbAreaChart>
    </div>

    <div class="flex gap-2">
        <BbButton Variant="ButtonVariant.Secondary" @onclick="OnRequeueReady" Disabled="_isOperating">
            <LucideIcon Name="refresh-cw" Size="16" class="mr-2"/>
            Requeue Ready
        </BbButton>
        <BbButton Variant="ButtonVariant.Secondary" @onclick="OnRequeueStuck" Disabled="_isOperating">
            <LucideIcon Name="rotate-ccw" Size="16" class="mr-2"/>
            Requeue Stuck
        </BbButton>
    </div>

    <div class="flex flex-col gap-3">
        <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">
            Retry Queue
            @if (_data.RetryEntries.Count > 0)
            {
                <span class="font-normal normal-case tracking-normal ml-2">(@_data.RetryEntries.Count)</span>
            }
        </h2>

        <div class="rounded-lg border">
            <table class="w-full text-sm">
                <thead>
                <tr class="border-b bg-muted/50">
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">ID</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Type</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Retries</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Retry After</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Created</th>
                    <th class="h-10 px-4 w-24"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _data.RetryEntries)
                {
                    <tr class="border-b last:border-b-0 hover:bg-muted/30">
                        <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">@(entry.Id.ToString()[..8])&hellip;</td>
                        <td class="px-4 py-2.5 text-xs">@entry.TypeName</td>
                        <td class="px-4 py-2.5 text-xs">@entry.RetryCount</td>
                        <td class="px-4 py-2.5 text-xs text-muted-foreground">@entry.RetryAfter.ToString("HH:mm:ss")</td>
                        <td class="px-4 py-2.5 text-xs text-muted-foreground">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-4 py-2.5">
                            <div class="flex gap-1 justify-end">
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                          @onclick="@(() => OnRequeueEntry(entry.Id))" Disabled="_isOperating"
                                          title="Requeue">
                                    <LucideIcon Name="rotate-ccw" Size="14"/>
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                          @onclick="@(() => OnDropEntry(entry.Id))" Disabled="_isOperating"
                                          title="Drop">
                                    <LucideIcon Name="trash-2" Size="14" class="text-destructive"/>
                                </BbButton>
                            </div>
                        </td>
                    </tr>
                }
                @if (_data.RetryEntries.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-muted-foreground">No entries in retry queue</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    [Inject] public ILiveState<SideEffectsLiveData> LiveData { get; set; } = null!;
    [Inject] public ISideEffectsStorage Storage { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;

    private SideEffectsLiveData _data = new();
    private List<ThroughputRow> _chartData = [];
    private bool _isOperating;

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        LiveData.View(lifetime, data => {
            _data = data;
            BuildChartData();
            InvokeAsync(StateHasChanged).NoAwait();
        });

        return Task.CompletedTask;
    }

    private async Task OnRequeueReady()
    {
        _isOperating = true;

        try
        {
            await Storage.RequeueReady();
            ToastService.Success("Ready entries requeued", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Requeue ready failed: {ex.Message}", "Error");
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task OnRequeueStuck()
    {
        _isOperating = true;

        try
        {
            await Storage.RequeueStuck();
            ToastService.Success("Stuck entries requeued", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Requeue stuck failed: {ex.Message}", "Error");
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task OnRequeueEntry(Guid id)
    {
        _isOperating = true;

        try
        {
            await Storage.RequeueRetryEntry(id);
            ToastService.Success("Entry requeued", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Requeue entry failed: {ex.Message}", "Error");
        }
        finally
        {
            _isOperating = false;
        }
    }

    private async Task OnDropEntry(Guid id)
    {
        _isOperating = true;

        try
        {
            await Storage.DropRetryEntry(id);
            ToastService.Success("Entry dropped", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Drop entry failed: {ex.Message}", "Error");
        }
        finally
        {
            _isOperating = false;
        }
    }

    private void BuildChartData()
    {
        _chartData = _data.ThroughputHistory.Select(e => new ThroughputRow {
            key = e.Timestamp.ToString("HH:mm:ss"),
            processed = (int)e.Processed,
            failed = (int)e.Failed
        }).ToList();
    }

    private class ThroughputRow {
        public string key { get; set; } = "";
        public int processed { get; set; }
        public int failed { get; set; }
    }
}
