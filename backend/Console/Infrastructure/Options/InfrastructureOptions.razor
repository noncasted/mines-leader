@page "/infrastructure-options"
@using global::Common.Extensions
@using global::Infrastructure
@using global::Infrastructure.Execution

<PageTitle>Infrastructure Options</PageTitle>
<PageHeader Title="Infrastructure Options"/>

<div class="container mx-auto max-w-5xl px-4 py-4 flex flex-col gap-4">
    <div class="flex gap-2">
        <BbButton @onclick="Reload">
            <LucideIcon Name="refresh-cw" Size="16" class="mr-2"/>
            Reload
        </BbButton>
        <BbButton Variant="ButtonVariant.Secondary" @onclick="Save">
            <LucideIcon Name="save" Size="16" class="mr-2"/>
            Save
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" @onclick="UpdateJson" Disabled="_isUpdatingJson">
            <LucideIcon Name="file-json" Size="16" class="mr-2"/>
            Write JSON
        </BbButton>
    </div>

    <SideEffectsOptionsEditor Value="_sideEffectsValue"/>
    <DurableQueueOptionsEditor Value="_durableQueueValue"/>
    <TaskBalancerOptionsEditor Value="_taskBalancerValue"/>
    <TransactionOptionsEditor Value="_transactionValue"/>
</div>

@code {
    [Inject] public ISideEffectsConfig SideEffectsConfig { get; set; } = null!;
    [Inject] public IDurableQueueConfig DurableQueueConfig { get; set; } = null!;
    [Inject] public ITaskBalancerConfig TaskBalancerConfig { get; set; } = null!;
    [Inject] public ITransactionConfig TransactionConfig { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;
    [Inject] public IAuditLogStorage AuditLog { get; set; } = null!;

    private SideEffectsOptions _sideEffectsValue = new();
    private DurableQueueOptions _durableQueueValue = new();
    private TaskBalancerOptions _taskBalancerValue = new();
    private TransactionOptions _transactionValue = new();

    private bool _isUpdatingJson;

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        ReloadField(SideEffectsConfig.Value, ref _sideEffectsValue);
        ReloadField(DurableQueueConfig.Value, ref _durableQueueValue);
        ReloadField(TaskBalancerConfig.Value, ref _taskBalancerValue);
        ReloadField(TransactionConfig.Value, ref _transactionValue);
        InvokeAsync(StateHasChanged);

        return;

        void ReloadField<T>(T current, ref T field)
        {
            var raw = JsonUtils.Serialize(current!);
            field = JsonUtils.Deserialize<T>(raw);
        }
    }

    private async Task Save()
    {
        await SideEffectsConfig.SetValue(_sideEffectsValue);
        await DurableQueueConfig.SetValue(_durableQueueValue);
        await TaskBalancerConfig.SetValue(_taskBalancerValue);
        await TransactionConfig.SetValue(_transactionValue);
        await AuditLog.Write("InfrastructureOptionsSaved", "Infrastructure options updated");
        ToastService.Success("Infrastructure options saved", "Saved");
    }

    private async Task UpdateJson()
    {
        _isUpdatingJson = true;

        var coordinatorFolder = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "Coordinator");

        try
        {
            await SaveConfig("config.sideEffects", _sideEffectsValue);
            await SaveConfig("config.durableQueue", _durableQueueValue);
            await SaveConfig("config.taskBalancer", _taskBalancerValue);
            await SaveConfig("config.transaction", _transactionValue);

            ToastService.Success("Infrastructure options saved to JSON", "Saved");
        }
        catch (Exception ex)
        {
            ToastService.Error($"[InfrastructureOptions] Failed to write JSON: {ex.Message}", "Error");
        }
        finally
        {
            _isUpdatingJson = false;
        }

        return;

        async Task SaveConfig<T>(string jsonPath, T value)
        {
            var configPath = Path.Combine(coordinatorFolder, $"{jsonPath}.json");
            var fullPath = Path.GetFullPath(configPath);
            var json = JsonUtils.Serialize(value!).ThrowIfNull();
            await File.WriteAllTextAsync(fullPath, json);
        }
    }

}
