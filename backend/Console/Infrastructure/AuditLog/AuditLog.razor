@page "/audit"

<PageTitle>Audit Log</PageTitle>
<PageHeader Title="Audit Log"/>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-16">
        <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
    </div>
    return;
}

<div class="container mx-auto max-w-5xl px-4 py-4 flex flex-col gap-6">

    <div class="flex items-center justify-between">
        <span class="text-sm text-muted-foreground">@_totalCount entries total</span>
        <BbButton Variant="ButtonVariant.Outline" @onclick="Refresh">
            <LucideIcon Name="refresh-cw" Size="16" class="mr-2"/>
            Refresh
        </BbButton>
    </div>

    <div class="rounded-lg border">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b bg-muted/50">
                <th class="h-10 px-4 text-left font-medium text-muted-foreground">Timestamp</th>
                <th class="h-10 px-4 text-left font-medium text-muted-foreground">Action</th>
                <th class="h-10 px-4 text-left font-medium text-muted-foreground">Details</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in _entries)
            {
                <tr class="border-b last:border-b-0 hover:bg-muted/30">
                    <td class="px-4 py-2.5 text-xs text-muted-foreground whitespace-nowrap">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="px-4 py-2.5 text-xs">
                        <span class="bg-primary/10 text-primary px-1.5 py-0.5 rounded font-medium">@entry.Action</span>
                    </td>
                    <td class="px-4 py-2.5 text-xs text-muted-foreground break-all">@entry.Details</td>
                </tr>
            }
            @if (_entries.Count == 0)
            {
                <tr>
                    <td colspan="3" class="px-4 py-8 text-center text-muted-foreground">No audit entries</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (_totalPages > 1)
    {
        <div class="flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Page @(_page + 1) / @_totalPages</span>
            <div class="flex items-center gap-1">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Disabled="@(_page == 0)"
                          @onclick="PrevPage">
                    <LucideIcon Name="chevron-left" Size="14"/>
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Disabled="@(_page >= _totalPages - 1)"
                          @onclick="NextPage">
                    <LucideIcon Name="chevron-right" Size="14"/>
                </BbButton>
            </div>
        </div>
    }

</div>

@code {
    [Inject] public IAuditLogStorage AuditStorage { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;

    private const int PageSize = 30;

    private IReadOnlyList<AuditEntry> _entries = [];
    private int _totalCount;
    private int _page;
    private int _totalPages;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
        _isLoading = false;
    }

    private async Task LoadPage()
    {
        try
        {
            var result = await AuditStorage.GetPage(_page * PageSize, PageSize);
            _entries = result.Entries;
            _totalCount = result.TotalCount;
            _totalPages = _totalCount == 0 ? 1 : (_totalCount + PageSize - 1) / PageSize;
        }
        catch (Exception ex)
        {
            ToastService.Error($"[AuditLog] {ex.Message}", "Error");
        }
    }

    private async Task Refresh()
    {
        _page = 0;
        await LoadPage();
    }

    private async Task PrevPage()
    {
        if (_page <= 0) return;
        _page--;
        await LoadPage();
    }

    private async Task NextPage()
    {
        if (_page >= _totalPages - 1) return;
        _page++;
        await LoadPage();
    }
}
