@page "/"

<PageTitle>Console</PageTitle>

<div class="container mx-auto px-6 py-10 max-w-5xl">
    <div class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight">Mines Leader Console</h1>
        <p class="text-muted-foreground mt-1">Game management and administration panel</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <HomeNavCard
            Icon="flask-conical"
            Title="Tests"
            Description="Run cluster integration tests and check service health"
            Target="@ConsoleConstants.Pages.Tests" />

        <HomeNavCard
            Icon="sliders-horizontal"
            Title="Configs"
            Description="Edit game mode, bot and card configurations"
            Target="@ConsoleConstants.Pages.Configs" />

        <HomeNavCard
            Icon="bot"
            Title="Bots"
            Description="Manage bot players, create bots and edit their decks"
            Target="@ConsoleConstants.Pages.Bots" />
    </div>
</div>

