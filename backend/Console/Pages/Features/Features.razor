@page "/features"
@using Cluster.State
@using global::Common.Extensions
@using global::Common.Reactive
@inherits UiComponent

<PageTitle>Features</PageTitle>
<PageHeader Title="Features"/>

<div class="container mx-auto max-w-3xl px-4 py-4 flex flex-col gap-4">

    @if (!ClusterFeatures.IsInitialized)
    {
        <div class="flex items-center justify-center py-16">
            <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
        </div>
        return;
    }

    <div class="rounded-lg border bg-card p-6 flex flex-col gap-4">
        <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Cluster</h2>

        <FeatureToggle
            Label="Accepting Connections"
            Description="Allow new player connections to the cluster"
            Value="_state.AcceptingConnections"
            OnToggle="ToggleAcceptingConnections"
            Saving="_isSaving" />

        <FeatureToggle
            Label="Matchmaking"
            Description="Allow the matchmaking loop to create new matches"
            Value="_state.MatchmakingEnabled"
            OnToggle="ToggleMatchmakingEnabled"
            Saving="_isSaving" />

        <FeatureToggle
            Label="Side Effects"
            Description="Allow the side effects worker to process queued effects"
            Value="_state.SideEffectsEnabled"
            OnToggle="ToggleSideEffectsEnabled"
            Saving="_isSaving" />
    </div>

</div>

@code {
    [Inject] public IClusterFeatures ClusterFeatures { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;
    [Inject] public IAuditLogStorage AuditLog { get; set; } = null!;

    private ClusterFeaturesState _state = new();
    private bool _isSaving;

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        ClusterFeatures.View(lifetime, state =>
        {
            _state = state;
            InvokeAsync(StateHasChanged).NoAwait();
        });

        return Task.CompletedTask;
    }

    private Task ToggleAcceptingConnections() => Toggle("AcceptingConnections", v => ClusterFeatures.SetAcceptingConnections(v), !_state.AcceptingConnections);
    private Task ToggleMatchmakingEnabled() => Toggle("Matchmaking", v => ClusterFeatures.SetMatchmakingEnabled(v), !_state.MatchmakingEnabled);
    private Task ToggleSideEffectsEnabled() => Toggle("SideEffects", v => ClusterFeatures.SetSideEffectsEnabled(v), !_state.SideEffectsEnabled);

    private async Task Toggle(string name, Func<bool, Task> setter, bool newValue)
    {
        _isSaving = true;

        try
        {
            await setter(newValue);
            await AuditLog.Write("FeatureToggled", $"{name} set to {newValue}");
            ToastService.Success("Feature updated", "Saved");
        }
        catch (Exception ex)
        {
            ToastService.Error($"[Features] Failed to toggle feature: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
        
        
    }

}
