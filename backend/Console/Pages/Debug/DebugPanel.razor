@page "/debug"
@using System.Net.Http.Json
@implements IDisposable

<PageTitle>Debug Panel</PageTitle>
<PageHeader Title="Debug Panel"/>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-16">
        <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
    </div>
    return;
}

<div class="container mx-auto max-w-4xl px-4 py-4 flex flex-col gap-6">

    @if (_error != null)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <ChildContent>
                <BbAlertTitle>Connection Error</BbAlertTitle>
                <BbAlertDescription>@_error</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }

    <div class="flex flex-col gap-3">
        <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">
            Active Sessions
            <span class="font-normal normal-case tracking-normal ml-2">(@_sessions.Count)</span>
        </h2>

        <div class="rounded-lg border">
            <table class="w-full text-sm">
                <thead>
                <tr class="border-b bg-muted/50">
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">ID</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Type</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground">Players</th>
                    <th class="h-10 px-4 w-10"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var session in _sessions)
                {
                    var isSelected = _selectedSession?.Id == session.Id;
                    <tr class="border-b last:border-b-0 hover:bg-muted/30 cursor-pointer @(isSelected ? "bg-primary/5" : "")"
                        @onclick="@(() => SelectSession(session))">
                        <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">@(session.Id.ToString()[..8])&hellip;</td>
                        <td class="px-4 py-2.5 text-xs">
                            <span class="bg-primary/10 text-primary px-1.5 py-0.5 rounded font-medium">@session.Type</span>
                        </td>
                        <td class="px-4 py-2.5 text-xs">@session.PlayerCount</td>
                        <td class="px-4 py-2.5">
                            @if (isSelected)
                            {
                                <LucideIcon Name="check" Size="14" class="text-primary"/>
                            }
                        </td>
                    </tr>
                }
                @if (_sessions.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="px-4 py-8 text-center text-muted-foreground">No active sessions</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (_selectedSession != null && _players.Count > 0)
    {
        <div class="rounded-lg border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-sm font-semibold">Send Cheat Command</h3>

            <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-medium text-muted-foreground">Player</label>
                    <select @bind="_selectedPlayerIndex"
                            class="h-9 rounded-md border border-input bg-transparent px-3 text-sm shadow-sm">
                        @foreach (var player in _players)
                        {
                            <option value="@player.Index">Player @player.Index (@(player.IsBot ? "Bot" : "Human") — @(player.Id.ToString()[..8]))</option>
                        }
                    </select>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-medium text-muted-foreground">Command</label>
                    <select @bind="_selectedCommand"
                            class="h-9 rounded-md border border-input bg-transparent px-3 text-sm shadow-sm">
                        <option value="ChangeMana">Change Mana</option>
                        <option value="ChangeHealth">Change Health</option>
                        <option value="ChangeMoves">Change Moves</option>
                        <option value="ChangeMaxMana">Change Max Mana</option>
                        <option value="CardAdd">Add Card</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @if (_selectedCommand == "CardAdd")
                {
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-muted-foreground">Card Type</label>
                        <input type="text" @bind="_cardType" placeholder="Bloodhound"
                               class="h-9 rounded-md border border-input bg-transparent px-3 text-sm shadow-sm"/>
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-muted-foreground">Value</label>
                        <input type="number" @bind="_value"
                               class="h-9 rounded-md border border-input bg-transparent px-3 text-sm shadow-sm"/>
                    </div>
                }
            </div>

            <BbButton @onclick="ExecuteCommand" Disabled="_isExecuting">
                <LucideIcon Name="play" Size="16" class="mr-2"/>
                Execute
            </BbButton>
        </div>
    }

</div>

@code {
    [Inject] public IHttpClientFactory HttpClientFactory { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;

    private record SessionDto
    {
        public Guid Id { get; init; }
        public string Type { get; init; } = string.Empty;
        public int PlayerCount { get; init; }
        public DateTime CreatedAt { get; init; }
    }

    private record PlayerDto
    {
        public Guid Id { get; init; }
        public int Index { get; init; }
        public bool IsBot { get; init; }
    }

    private List<SessionDto> _sessions = new();
    private List<PlayerDto> _players = new();
    private SessionDto? _selectedSession;
    private int _selectedPlayerIndex = 1;
    private string _selectedCommand = "ChangeMana";
    private int _value = 1;
    private string _cardType = "Bloodhound";
    private bool _isLoading = true;
    private bool _isExecuting;
    private string? _error;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshSessions();
        _isLoading = false;
        _timer = new Timer(_ => InvokeAsync(RefreshSessions), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshSessions()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("game");
            _sessions = await client.GetFromJsonAsync<List<SessionDto>>("/api/sessions") ?? [];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Cannot reach Game Gateway: {ex.Message}";
            _sessions = [];
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectSession(SessionDto session)
    {
        _selectedSession = session;
        _players = [];

        try
        {
            var client = HttpClientFactory.CreateClient("game");
            _players = await client.GetFromJsonAsync<List<PlayerDto>>($"/api/sessions/{session.Id}/players") ?? [];

            if (_players.Count > 0)
                _selectedPlayerIndex = _players[0].Index;
        }
        catch (Exception ex)
        {
            ToastService.Error($"[DebugPanel] Failed to load players: {ex.Message}", "Error");
        }
    }

    private async Task ExecuteCommand()
    {
        if (_selectedSession == null) return;

        _isExecuting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("game");
            var request = new
            {
                PlayerIndex = _selectedPlayerIndex,
                Command = _selectedCommand,
                Value = _value,
                CardType = _cardType
            };

            var response = await client.PostAsJsonAsync($"/api/debug/session/{_selectedSession.Id}/cheat", request);

            if (response.IsSuccessStatusCode)
                ToastService.Success("Command executed", "Done");
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ToastService.Error($"Command failed: {body}", "Error");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"[DebugPanel] {ex.Message}", "Error");
        }
        finally
        {
            _isExecuting = false;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
