@using Shared

<div class="rounded-lg border bg-card p-4 flex flex-col gap-4">

    <div class="flex items-start justify-between">
        <div class="flex items-center gap-2">
            <h3 class="text-lg font-semibold @(IsWinner ? "text-green-400" : "text-red-400")">@Name</h3>
            @if (IsWinner)
            {
                <span class="text-xs bg-green-500/10 text-green-400 px-1.5 py-0.5 rounded font-medium">Winner</span>
            }
            else
            {
                <span class="text-xs bg-red-500/15 text-red-400 px-1.5 py-0.5 rounded">Loss</span>
            }
        </div>
        <div class="flex flex-col items-end gap-1">
            <span class="text-2xl font-bold">@CurrentRating</span>
            <span class="text-xs text-muted-foreground uppercase tracking-wide">Rating</span>
        </div>
    </div>

    <div class="flex items-center gap-2">
        <span class="text-xs text-muted-foreground">Rating change:</span>
        @if (RatingChange > 0)
        {
            <span class="text-sm font-semibold text-green-400">+@RatingChange</span>
        }
        else if (RatingChange < 0)
        {
            <span class="text-sm font-semibold text-red-400">@RatingChange</span>
        }
        else
        {
            <span class="text-sm text-muted-foreground">—</span>
        }
    </div>

    <div class="flex flex-col gap-2">
        <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-1">Deck</h4>
        @if (Deck.Count == 0)
        {
            <p class="text-xs text-muted-foreground">No deck data</p>
        }
        else
        {
            <div class="flex flex-wrap gap-1">
                @foreach (var card in Deck)
                {
                    <span class="text-xs bg-muted px-2 py-1 rounded">@card</span>
                }
            </div>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int CurrentRating { get; set; }
    [Parameter, EditorRequired] public int RatingChange { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<CardType> Deck { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsWinner { get; set; }
}
