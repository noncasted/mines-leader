@page "/bots/{Id}"
@using Cluster.Configs
@using global::Infrastructure
@using Meta.Bots
@using Meta.Users
@using Shared

<PageTitle>Edit Bot</PageTitle>
<PageHeader Title="Bot Settings"/>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-16">
        <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
    </div>

    return;
}

@if (_bot == null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <ChildContent>
            <BbAlertTitle>Not Found</BbAlertTitle>
            <BbAlertDescription>Bot not found</BbAlertDescription>
        </ChildContent>
    </BbAlert>

    return;
}

<div class="container mx-auto max-w-2xl px-4 py-4">

    <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Bot
                Information</h2>
            <div class="flex flex-col gap-1 max-w-sm">
                <BbLabel>Name</BbLabel>
                <BbInput @bind-Value="_botName"/>
            </div>
            <p class="text-xs text-muted-foreground font-mono">ID: @_bot.Id</p>
        </div>

        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between border-b pb-2">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Deck</h2>
                <span class="text-xs text-muted-foreground">Avg mana: @GetAverageMana().ToString("F1")</span>
            </div>
            <div class="flex flex-col divide-y divide-border/60">
                @foreach (var (index, card) in _deckCards.Select((c, i) => (i, c)))
                {
                    <div class="flex items-center gap-3 py-2">
                        <span class="w-12 shrink-0 text-xs text-muted-foreground">Card @(index + 1)</span>
                        <div class="flex-1">
                            <BbSelect @bind-Value="_deckCards[index]">
                                <BbSelectTrigger>
                                    <BbSelectValue Placeholder="Select card"/>
                                </BbSelectTrigger>
                                <BbSelectContent>
                                    <BbSelectGroup>
                                        @foreach (var cardType in CardTypeExtensions.All)
                                        {
                                            <BbSelectItem Value="@cardType" Text="@cardType.ToString()">
                                                @cardType.ToString()
                                            </BbSelectItem>
                                        }
                                    </BbSelectGroup>
                                </BbSelectContent>
                            </BbSelect>
                        </div>
                        <span
                            class="w-16 shrink-0 text-right text-xs text-muted-foreground">@GetCardManaCost(card) mana</span>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-2 pt-2">
            <BbButton @onclick="SaveChanges">Save</BbButton>
            <BbButton Variant="ButtonVariant.Ghost" @onclick="NavigateBack">Cancel</BbButton>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Inject] public IBotCollection BotCollection { get; set; } = null!;
    [Inject] public IOrleans Orleans { get; set; } = null!;
    [Inject] public ICardConfigs CardConfigs { get; set; } = null!;
    [Inject] public NavigationManager Navigation { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;

    private BotState? _bot;
    private string _botName = string.Empty;
    private List<CardType> _deckCards = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        if (Guid.TryParse(Id, out var botId) && BotCollection.TryGetValue(botId, out var bot))
        {
            _bot = bot;

            try
            {
                await Orleans.InTransaction(async () =>
                    {
                        var handle = Orleans.CreateUserHandle(botId);
                        var selectedDeck = await handle.Deck.GetSelected();
                        _deckCards = new List<CardType>(selectedDeck);
                        var entityState = await handle.Entity.GetState();
                        _botName = entityState.Name;
                    }
                );
            }
            catch (Exception ex)
            {
                ToastService.Error($"[BotEditor] Error loading deck: {ex.Message}", "Error");
                _deckCards = new List<CardType>();
            }
        }

        _isLoading = false;
    }

    private int GetCardManaCost(CardType cardType)
    {
        if (CardConfigs.Value.All.TryGetValue(cardType, out var config))
            return config.ManaCost;
        return 0;
    }

    private float GetAverageMana()
    {
        if (_deckCards.Count == 0)
            return 0;
        return (float)_deckCards.Sum(GetCardManaCost) / _deckCards.Count;
    }

    private async Task SaveChanges()
    {
        if (_bot == null)
            return;

        try
        {
            await Orleans.Transactions.Run(async () =>
                {
                    var handle = Orleans.CreateUserHandle(_bot.Id);
                    var deckUpdate = new Dictionary<int, IReadOnlyList<CardType>> { { 0, _deckCards } };
                    await handle.Entity.SetName(_botName);
                    await handle.Deck.Update(deckUpdate, 0);
                    var botEntity = Orleans.GetGrain<IBot>(_bot.Id);
                    await botEntity.OnUpdated();
                }
            );

            ToastService.Success("Bot saved successfully", "Saved");
            NavigateBack();
        }
        catch (Exception ex)
        {
            ToastService.Error($"[BotEditor] Error saving bot: {ex.Message}", "Error");
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/bots");
    }

}
