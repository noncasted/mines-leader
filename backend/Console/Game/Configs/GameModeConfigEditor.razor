@using Shared
<div class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
        <div class="flex items-center gap-2">
            <div class="rounded-md bg-red-500/15 p-1.5">
                <LucideIcon Name="sword" Size="14" class="text-red-400" />
            </div>
            <h2 class="text-sm font-semibold">Last Man Standing</h2>
        </div>
        <div class="flex flex-col">
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="heart" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Health</span>
                <input type="number" @bind="Value.LastManStanding.PlayerHealth"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="move" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Moves</span>
                <input type="number" @bind="Value.LastManStanding.PlayerMoves"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="droplets" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Start Mana</span>
                <input type="number" @bind="Value.LastManStanding.PlayerStartMana"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="clock" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Round Time (sec)</span>
                <input type="number" @bind="Value.LastManStanding.RoundTime"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5">
                <LucideIcon Name="layers" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Card Moves Cost</span>
                <input type="number" min="0" @bind="Value.LastManStanding.CardMovesCost"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
        </div>
    </div>

    <div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
        <div class="flex items-center gap-2">
            <div class="rounded-md bg-amber-500/15 p-1.5">
                <LucideIcon Name="timer" Size="14" class="text-amber-400" />
            </div>
            <h2 class="text-sm font-semibold">Time Limited</h2>
        </div>
        <div class="flex flex-col">
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="heart" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Health</span>
                <input type="number" @bind="Value.TimeLimited.PlayerHealth"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="move" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Moves</span>
                <input type="number" @bind="Value.TimeLimited.PlayerMoves"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="droplets" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Start Mana</span>
                <input type="number" @bind="Value.TimeLimited.PlayerStartMana"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="clock" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Round Time (sec)</span>
                <input type="number" @bind="Value.TimeLimited.RoundTime"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="plus-circle" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Time Gain Per Action (sec)</span>
                <input type="number" @bind="Value.TimeLimited.TimeGainPerAction"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5">
                <LucideIcon Name="layers" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Card Moves Cost</span>
                <input type="number" min="0" @bind="Value.TimeLimited.CardMovesCost"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
        </div>
    </div>

    <div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
        <div class="flex items-center gap-2">
            <div class="rounded-md bg-violet-500/15 p-1.5">
                <LucideIcon Name="repeat" Size="14" class="text-violet-400" />
            </div>
            <h2 class="text-sm font-semibold">Last Man Standing (Turn Based)</h2>
        </div>
        <div class="flex flex-col">
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="heart" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Health</span>
                <input type="number" @bind="Value.LastManStandingTurnBased.PlayerHealth"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="move" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Moves</span>
                <input type="number" @bind="Value.LastManStandingTurnBased.PlayerMoves"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="droplets" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Player Start Mana</span>
                <input type="number" @bind="Value.LastManStandingTurnBased.PlayerStartMana"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="gauge" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Max Mana Cap</span>
                <input type="number" @bind="Value.LastManStandingTurnBased.MaxManaCap"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
                <LucideIcon Name="layers" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Card Moves Cost</span>
                <input type="number" min="0" @bind="Value.LastManStandingTurnBased.CardMovesCost"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <div class="flex items-center gap-3 py-1.5">
                <LucideIcon Name="eye" Size="12" class="text-muted-foreground shrink-0" />
                <span class="text-sm flex-1">Include Oracle</span>
                <input type="checkbox" @bind="Value.LastManStandingTurnBased.IncludeOracle"
                       class="h-4 w-4 rounded border border-input" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameModeOptions Value { get; set; } = null!;
}
