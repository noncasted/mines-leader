@using Shared

<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground">Cards — click to toggle</span>
        <span class="text-xs font-medium @(IsValid ? "text-green-400" : "text-red-400")">
            @Value.Count / @DeckSize
        </span>
    </div>

    @if (!IsValid)
    {
        <div class="rounded-md border border-red-500/30 bg-red-500/10 px-3 py-2">
            <span class="text-xs text-red-400">Base deck must contain exactly @DeckSize cards. Currently has @Value.Count.</span>
        </div>
    }

    <div class="grid grid-cols-4 sm:grid-cols-6 gap-2">
        @foreach (var type in _allCards)
        {
            var isSelected = Value.Contains(type);
            <button
                @onclick="() => ToggleCard(type)"
                class="relative flex flex-col items-center justify-center gap-1 rounded-md border p-2 transition-all cursor-pointer
                       @(isSelected ? "border-green-500 bg-green-500/10 ring-1 ring-green-500" : "border-border bg-card hover:bg-muted/50")
                       @GetDisabledClass(type)"
                disabled="@GetDisabled(type)">
                <span class="text-[10px] font-semibold leading-tight text-center">@type</span>
                @if (isSelected)
                {
                    <div class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-green-500 flex items-center justify-center">
                        <LucideIcon Name="check" Size="8" class="text-white" />
                    </div>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<CardType> Value { get; set; } = null!;
    [Parameter, EditorRequired] public int DeckSize { get; set; } = 6;

    private static readonly CardType[] _allCards = CardTypeExtensions.All.ToArray();

    private bool IsValid => Value.Count == DeckSize;

    private void ToggleCard(CardType type)
    {
        if (Value.Contains(type))
        {
            Value.Remove(type);
        }
        else if (Value.Count < DeckSize)
        {
            Value.Add(type);
        }
    }

    private bool GetDisabled(CardType type)
    {
        return !Value.Contains(type) && Value.Count >= DeckSize;
    }

    private string GetDisabledClass(CardType type)
    {
        return GetDisabled(type) ? "opacity-40 cursor-not-allowed" : "";
    }
}
