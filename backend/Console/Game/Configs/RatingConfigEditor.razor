@using Shared
<div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
    <div class="flex items-center gap-2">
        <div class="rounded-md bg-yellow-500/15 p-1.5">
            <LucideIcon Name="trophy" Size="14" class="text-yellow-400" />
        </div>
        <h2 class="text-sm font-semibold">Rating Configuration</h2>
    </div>
    <div class="flex flex-col">
        <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
            <LucideIcon Name="trending-up" Size="12" class="text-muted-foreground shrink-0" />
            <span class="text-sm flex-1">Win Rating</span>
            <input type="number" @bind="Value.WinRating"
                   class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
        </div>
        <div class="flex items-center gap-3 py-1.5">
            <LucideIcon Name="trending-down" Size="12" class="text-muted-foreground shrink-0" />
            <span class="text-sm flex-1">Loss Rating</span>
            <input type="number" @bind="Value.LossRating"
                   class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RatingOptions Value { get; set; } = null!;
}
