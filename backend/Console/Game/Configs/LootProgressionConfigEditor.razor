@using Shared
<div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
    <div class="flex items-center gap-2">
        <div class="rounded-md bg-amber-500/15 p-1.5">
            <LucideIcon Name="gift" Size="14" class="text-amber-400" />
        </div>
        <h2 class="text-sm font-semibold">Loot Progression</h2>
    </div>

    @for (var i = 0; i < Value.Thresholds.Count; i++)
    {
        var index = i;

        <div class="flex items-center gap-3 py-1.5 border-b border-border/60">
            <LucideIcon Name="star" Size="12" class="text-muted-foreground shrink-0" />
            <span class="text-sm w-20">Loot Box @(index + 1)</span>
            <div class="flex items-center gap-1">
                <span class="text-xs text-muted-foreground">XP</span>
                <input type="number" @bind="Value.Thresholds[index]"
                       class="w-24 h-8 rounded-md border border-input bg-transparent px-2 text-sm shadow-sm" />
            </div>
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                      @onclick="() => Value.Thresholds.RemoveAt(index)">
                <LucideIcon Name="trash-2" Size="12" />
            </BbButton>
        </div>
    }

    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
              @onclick="() => Value.Thresholds.Add(0)">
        <LucideIcon Name="plus" Size="12" class="mr-1" />
        Add Threshold
    </BbButton>
</div>

@code {
    [Parameter, EditorRequired] public LootProgressionOptions Value { get; set; } = null!;
}
