@using Shared
<div class="flex flex-col gap-3">
    <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Decks</span>
        <button @onclick="AddDeck"
                class="inline-flex items-center gap-1 rounded-md bg-primary px-2 py-1 text-xs font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
            <LucideIcon Name="plus" Size="12" />
            Add
        </button>
    </div>

    @if (Config.Decks.Count == 0)
    {
        <div class="rounded-md border border-dashed border-border p-4 text-center">
            <span class="text-xs text-muted-foreground">No decks configured. Bots will use the legacy fallback pool.</span>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-1.5">
            @foreach (var (index, deck) in Config.Decks.Select((d, i) => (i, d)))
            {
                <div @key="index"
                     class="group relative flex items-center gap-3 rounded-md border border-border bg-card px-3 py-2 cursor-pointer hover:bg-muted/50 transition-colors"
                     @onclick="() => EditDeck(index)"
                     @onmouseenter="() => _hoveredIndex = index"
                     @onmouseleave="() => _hoveredIndex = -1">
                    <div class="flex flex-1 flex-col gap-0.5 min-w-0">
                        <span class="text-sm font-medium truncate">@deck.Name</span>
                        <span class="text-xs text-muted-foreground truncate">@string.Join(", ", deck.Cards)</span>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@deck.Cards.Count / @Config.DeckSize</span>

                    @if (_hoveredIndex == index)
                    {
                        <button @onclick="() => DeleteDeck(index)"
                                @onclick:stopPropagation
                                class="shrink-0 rounded-md p-1 text-muted-foreground hover:text-red-400 hover:bg-red-500/10 transition-colors">
                            <LucideIcon Name="trash-2" Size="14" />
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BotProfileConfig Config { get; set; } = null!;
    [Parameter] public EventCallback<int> OnEditDeck { get; set; }

    private int _hoveredIndex = -1;

    private void AddDeck()
    {
        Config.Decks.Add(new BotDeck
        {
            Name = $"Deck {Config.Decks.Count + 1}",
            Cards = new List<CardType>()
        });
    }

    private void DeleteDeck(int index)
    {
        if (index >= 0 && index < Config.Decks.Count)
            Config.Decks.RemoveAt(index);
    }

    private void EditDeck(int index)
    {
        OnEditDeck.InvokeAsync(index);
    }
}
