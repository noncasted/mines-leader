@page "/users/{Id}"
@using global::Infrastructure
@using global::Infrastructure.State
@using Marten
@using Meta.Matches
@using Meta.Users
@using Shared
@using System.Text.Json
@using global::Common
@using global::Common.Extensions


<PageTitle>Player Dashboard</PageTitle>
<PageHeader Title="Player Dashboard"/>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-16">
        <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
    </div>
    return;
}

@if (_user == null)
{
    <div class="container mx-auto max-w-4xl px-4 py-4">
        <BbAlert Variant="AlertVariant.Danger">
            <ChildContent>
                <BbAlertTitle>Not Found</BbAlertTitle>
                <BbAlertDescription>Player @Id not found</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    </div>
    return;
}

<div class="container mx-auto max-w-4xl px-4 py-4">
    <div class="flex flex-col gap-6">

        <div class="rounded-lg border bg-card p-6">
            <div class="flex items-start justify-between gap-4">
                <div class="flex flex-col gap-2">
                    <h1 class="text-2xl font-bold cursor-pointer hover:text-primary transition-colors select-none"
                        title="Click to copy" @onclick="@(() => CopyToClipboard(_user.Name))">
                        @_user.Name
                    </h1>
                    <p class="text-xs text-muted-foreground font-mono cursor-pointer hover:text-foreground transition-colors select-none"
                       title="Click to copy" @onclick="@(() => CopyToClipboard(_user.UserId.ToString()))">
                        @_user.UserId
                    </p>
                    <p class="text-xs text-muted-foreground">
                        Registered: @(_registeredAt.HasValue ? _registeredAt.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "—")
                    </p>
                </div>
                <div class="flex gap-6 shrink-0">
                    <div class="flex flex-col items-end gap-1">
                        <span class="text-2xl font-bold">@_xp</span>
                        <span class="text-xs text-muted-foreground uppercase tracking-wide">Experience</span>
                    </div>
                    <div class="flex flex-col items-end gap-1">
                        <span class="text-2xl font-bold">@_rating</span>
                        <span class="text-xs text-muted-foreground uppercase tracking-wide">Rating</span>
                    </div>
                </div>
            </div>
        </div>

        @* Rating Management *@
        <div class="flex flex-col gap-3">
            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Rating Management</h2>
            <div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
                <p class="text-sm text-muted-foreground">Current: <span class="font-bold text-foreground">@_rating</span></p>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-muted-foreground w-16 shrink-0">Adjust by</span>
                    <input type="number" @bind="_ratingDelta"
                           class="h-8 w-28 rounded border border-input bg-background px-2 text-sm"/>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="_isSaving" @onclick="AdjustRating">Apply</BbButton>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-muted-foreground w-16 shrink-0">Set to</span>
                    <input type="number" @bind="_ratingTarget"
                           class="h-8 w-28 rounded border border-input bg-background px-2 text-sm"/>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="_isSaving" @onclick="SetRating">Set</BbButton>
                </div>
            </div>
        </div>

        @* Progression Management *@
        <div class="flex flex-col gap-3">
            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Progression Management</h2>
            <div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
                <p class="text-sm text-muted-foreground">Current: <span class="font-bold text-foreground">@_xp</span> XP</p>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-muted-foreground w-16 shrink-0">Adjust by</span>
                    <input type="number" @bind="_progressionDelta"
                           class="h-8 w-28 rounded border border-input bg-background px-2 text-sm"/>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="_isSaving" @onclick="AdjustProgression">Apply</BbButton>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-muted-foreground w-16 shrink-0">Set to</span>
                    <input type="number" @bind="_progressionTarget"
                           class="h-8 w-28 rounded border border-input bg-background px-2 text-sm"/>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="_isSaving" @onclick="SetProgression">Set</BbButton>
                </div>
            </div>
        </div>

        @* Cards *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-2 border-b pb-2">
                <div class="flex items-center gap-2 cursor-pointer select-none flex-1"
                     @onclick="@(() => _cardsExpanded = !_cardsExpanded)">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                        Cards (@_ownedCards.Count / @CardTypeExtensions.All.Count)
                    </h2>
                    <LucideIcon Name="@(_cardsExpanded ? "chevron-up" : "chevron-down")" Size="14" class="text-muted-foreground"/>
                </div>
                @if (_ownedCards.Count < CardTypeExtensions.All.Count)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="_isSaving" @onclick="AddAllCards">Add all</BbButton>
                }
            </div>
            @if (_cardsExpanded)
            {
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var card in CardTypeExtensions.All)
                    {
                        var owned = _ownedCards.Contains(card);
                        <div class="@(owned ? "border-primary/30 bg-primary/10 text-primary" : "border-border bg-muted text-muted-foreground") border rounded px-2 py-1 flex items-center gap-1.5">
                            <span class="text-xs">@card.ToString().Replace("_", " ")</span>
                            @if (!owned)
                            {
                                <button class="text-xs font-bold leading-none hover:text-foreground transition-colors"
                                        disabled="@_isSaving"
                                        @onclick="@(() => AddCard(card))">+</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Decks *@
        <div class="flex flex-col gap-3">
            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Decks</h2>
            @if (_deckState == null || _deckState.Entries.Count == 0)
            {
                <p class="text-sm text-muted-foreground py-4 text-center">No decks found</p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var (index, entry) in _deckState.Entries.OrderBy(e => e.Key))
                    {
                        <div class="rounded-md border p-3">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-semibold text-muted-foreground">Deck @(index + 1)</span>
                                @if (index == _deckState.SelectedIndex)
                                {
                                    <span class="text-xs bg-primary/10 text-primary px-1.5 py-0.5 rounded">Active</span>
                                }
                                <span class="text-xs text-muted-foreground ml-auto">@entry.Cards.Count cards</span>
                            </div>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var card in entry.Cards)
                                {
                                    <span class="text-xs bg-muted px-2 py-1 rounded">@card</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Match History *@
        <div class="flex flex-col gap-3">
            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">
                Match History
                @if (_allMatches.Count > 0)
                {
                    <span class="font-normal normal-case tracking-normal ml-2">(@_allMatches.Count)</span>
                }
            </h2>
            <div class="rounded-lg border">
                <table class="w-full text-sm">
                    <thead>
                    <tr class="border-b bg-muted/50">
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Date</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Type</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Result</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Duration</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var match in _matchPageItems)
                    {
                        <tr class="border-b last:border-b-0 hover:bg-muted/30 cursor-pointer"
                            @onclick="@(() => Navigation.NavigateTo(string.Format(ConsoleConstants.Pages.Match, match.Id)))">
                            <td class="px-4 py-2.5 text-xs text-muted-foreground">@match.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-4 py-2.5 text-xs">@match.Type</td>
                            <td class="px-4 py-2.5">
                                @if (match.Winner == _userId)
                                {
                                    <span class="text-xs bg-green-500/10 text-green-600 dark:text-green-400 px-1.5 py-0.5 rounded font-medium">Win</span>
                                }
                                else
                                {
                                    <span class="text-xs bg-muted text-muted-foreground px-1.5 py-0.5 rounded">Loss</span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-xs text-muted-foreground">@match.Time.ToString(@"mm\:ss")</td>
                        </tr>
                    }
                    @if (_matchPageItems.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-4 py-8 text-center text-muted-foreground">No matches found</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (_matchTotalPages > 1)
            {
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">@_allMatches.Count matches total</span>
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  Disabled="@(_matchCurrentPage == 0)"
                                  @onclick="MatchPrevPage">
                            <LucideIcon Name="chevron-left" Size="14"/>
                        </BbButton>
                        <span class="text-xs text-muted-foreground px-2">@(_matchCurrentPage + 1) / @_matchTotalPages</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  Disabled="@(_matchCurrentPage >= _matchTotalPages - 1)"
                                  @onclick="MatchNextPage">
                            <LucideIcon Name="chevron-right" Size="14"/>
                        </BbButton>
                    </div>
                </div>
            }
        </div>

        @* States *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-2 border-b pb-2">
                <div class="flex items-center gap-2 cursor-pointer select-none flex-1"
                     @onclick="@(() => _statesExpanded = !_statesExpanded)">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">States</h2>
                    <LucideIcon Name="@(_statesExpanded ? "chevron-up" : "chevron-down")" Size="14" class="text-muted-foreground"/>
                </div>
            </div>
            @if (_statesExpanded)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var state in _userStates)
                    {
                        var isSelected = state.TableName == _selectedStateTable;
                        <button class="@(isSelected ? "border-green-500/50 bg-green-500/10 text-green-400 ring-1 ring-green-500/30" : "border-border bg-muted text-muted-foreground hover:border-primary/30 hover:text-foreground") border rounded px-3 py-2 text-xs font-medium transition-colors"
                                @onclick="@(() => SelectState(state.TableName))">
                            @state.Name
                        </button>
                    }
                </div>

                @if (_isLoadingState)
                {
                    <div class="flex items-center justify-center py-8">
                        <LucideIcon Name="loader-circle" Size="24" class="animate-spin text-primary"/>
                    </div>
                }
                else if (_selectedStateTable != null)
                {
                    <div class="grid grid-cols-2 gap-4">
                        @* State JSON *@
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-semibold text-muted-foreground">State JSON</h3>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="CopyStateJson">
                                    <LucideIcon Name="copy" Size="14" class="mr-1"/>
                                    Copy
                                </BbButton>
                            </div>
                            <div class="rounded-lg border bg-muted/30 p-3 overflow-auto max-h-[500px]">
                                <pre class="text-xs font-mono whitespace-pre-wrap break-all">@_stateJson</pre>
                            </div>
                        </div>

                        @* Marten Events *@
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-semibold text-muted-foreground">Marten Events (@_stateEvents.Count)</h3>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" @onclick="CopyEvents">
                                    <LucideIcon Name="copy" Size="14" class="mr-1"/>
                                    Copy
                                </BbButton>
                            </div>
                            <div class="rounded-lg border bg-muted/30 p-3 overflow-auto max-h-[500px]">
                                @if (_stateEvents.Count == 0)
                                {
                                    <p class="text-xs text-muted-foreground py-4 text-center">No events found</p>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-2">
                                        @foreach (var evt in _stateEvents)
                                        {
                                            <div class="rounded border border-border/50 bg-card p-2">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="text-[10px] font-mono text-muted-foreground">#@evt.SeqId</span>
                                                    <span class="text-[10px] font-semibold text-primary">@evt.EventType</span>
                                                    <span class="text-[10px] text-muted-foreground ml-auto">@evt.Timestamp.ToString("HH:mm:ss")</span>
                                                </div>
                                                <pre class="text-[11px] font-mono whitespace-pre-wrap break-all text-muted-foreground">@evt.Data</pre>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    [Inject] public IUserCollection UserCollection { get; set; } = null!;
    [Inject] public IStateStorage Storage { get; set; } = null!;
    [Inject] public IOrleans Orleans { get; set; } = null!;
    [Inject] public NavigationManager Navigation { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;
    [Inject] public IClipboard Clipboard { get; set; } = null!;
    [Inject] public IDocumentStore DocumentStore { get; set; } = null!;
    [Inject] public IStateSerializer StateSerializer { get; set; } = null!;


    private const int MatchPageSize = 10;

    private UserState? _user;
    private Guid _userId;
    private int _xp;
    private int _rating;
    private DateTime? _registeredAt;
    private UserDeckState? _deckState;
    private IReadOnlyList<MatchOverview> _allMatches = new List<MatchOverview>();
    private List<MatchOverview> _matchPageItems = new();
    private int _matchCurrentPage;
    private int _matchTotalPages;
    private bool _isLoading = true;
    private bool _isSaving;

    private int _ratingDelta;
    private int _ratingTarget;
    private int _progressionDelta;
    private int _progressionTarget;
    private HashSet<CardType> _ownedCards = new();
    private bool _cardsExpanded;
    private bool _statesExpanded;
    private List<GrainStateInfo> _userStates = new();
    private string? _selectedStateTable;
    private string? _stateJson;
    private List<MartenEvent> _stateEvents = new();
    private bool _isLoadingState;

    private record MartenEvent(long SeqId, string EventType, string Data, DateTime Timestamp);


    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;


        _userId = Guid.Parse(Id);

        if (_userId == Guid.Empty)
        {
            _isLoading = false;
            return;
        }

        UserCollection.TryGetValue(_userId, out _user);

        if (_user == null)
        {
            ToastService.Error($"Player with ID {_userId} not found", "Error");
            _isLoading = false;
            return;
        }

        try
        {
            await LoadPlayerData();
        }
        catch (Exception ex)
        {
            ToastService.Error($"[UserDashboard] Error loading player data: {ex.Message}", "Error");
        }

        _userStates = Storage.Registry.All
            .Where(s => s.KeyType == GrainKeyType.Guid && typeof(IEventStateValue).IsAssignableFrom(s.Type))
            .OrderBy(s => s.Name)
            .ToList();


        _isLoading = false;

    }

    private async Task LoadPlayerData()
    {
        var handle = Orleans.CreateUserHandle(_userId);

        await Orleans.InTransaction(async () =>
            {
                _xp = await handle.Progression.GetTotal();
                _rating = await handle.Rating.GetTotal();
                _deckState = await handle.Deck.GetState();
                _allMatches = (await handle.MatchHistory.GetBlock(100)).Reverse().ToList();
                _registeredAt = await handle.Auth.GetDate();
                var cards = await handle.Cards.GetAll();
                _ownedCards = new HashSet<CardType>(cards);
            }
        );

        _ratingTarget = _rating;
        _progressionTarget = _xp;

        _matchTotalPages = _allMatches.Count == 0 ? 1 : (_allMatches.Count + MatchPageSize - 1) / MatchPageSize;
        _matchCurrentPage = 0;
        _matchPageItems = _allMatches.Take(MatchPageSize).ToList();
    }

    private async Task CopyToClipboard(string text)
    {
        await Clipboard.Copy(text);
    }

    private async Task AdjustRating()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                await handle.Rating.AdjustRating(_ratingDelta);
                _rating = await handle.Rating.GetTotal();
            });
            _ratingTarget = _rating;
            ToastService.Success($"Rating adjusted by {_ratingDelta:+#;-#;0}", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SetRating()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                await handle.Rating.SetRating(_ratingTarget);
                _rating = await handle.Rating.GetTotal();
            });
            _ratingTarget = _rating;
            ToastService.Success($"Rating set to {_rating}", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AdjustProgression()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                await handle.Progression.AdjustProgression(_progressionDelta);
                _xp = await handle.Progression.GetTotal();
            });
            _progressionTarget = _xp;
            ToastService.Success($"Progression adjusted by {_progressionDelta:+#;-#;0}", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SetProgression()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                await handle.Progression.SetProgression(_progressionTarget);
                _xp = await handle.Progression.GetTotal();
            });
            _progressionTarget = _xp;
            ToastService.Success($"Progression set to {_xp}", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AddCard(CardType card)
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                await handle.Cards.AddCard(card);
                var cards = await handle.Cards.GetAll();
                _ownedCards = new HashSet<CardType>(cards);
            });
            ToastService.Success($"Card {card} added", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AddAllCards()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            var handle = Orleans.CreateUserHandle(_userId);
            await Orleans.InTransaction(async () =>
            {
                foreach (var card in CardTypeExtensions.All)
                    await handle.Cards.AddCard(card);
                var cards = await handle.Cards.GetAll();
                _ownedCards = new HashSet<CardType>(cards);
            });
            ToastService.Success("All cards added", "Done");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void MatchPrevPage()
    {
        if (_matchCurrentPage > 0)
        {
            _matchCurrentPage--;
            _matchPageItems = _allMatches.Skip(_matchCurrentPage * MatchPageSize).Take(MatchPageSize).ToList();
        }
    }

    private void MatchNextPage()
    {
        if (_matchCurrentPage < _matchTotalPages - 1)
        {
            _matchCurrentPage++;
            _matchPageItems = _allMatches.Skip(_matchCurrentPage * MatchPageSize).Take(MatchPageSize).ToList();
        }
    }

    private async Task SelectState(string tableName)
    {
        _selectedStateTable = _selectedStateTable == tableName ? null : tableName;
        _stateJson = null;
        _stateEvents = new();

        if (_selectedStateTable == null)
            return;

        _isLoadingState = true;
        try
        {
            var info = _userStates.First(s => s.TableName == _selectedStateTable);
            var identity = new StateIdentity
            {
                Key = _userId,
                Type = info.Name,
                Extension = null,
                TableName = info.TableName
            };

            var raw = await Storage.ReadRawJson(identity);
            _stateJson = string.IsNullOrEmpty(raw) ? "No state data" : FormatJson(raw);

            var streamId = $"{info.Name}:{_userId}";
            _stateEvents = await LoadEvents(streamId);
        }
        catch (Exception ex)
        {
            ToastService.Error($"[UserDashboard] Error loading state: {ex.Message}", "Error");
        }
        finally
        {
            _isLoadingState = false;
        }
    }

    private async Task<List<MartenEvent>> LoadEvents(string streamId)
    {
        var events = new List<MartenEvent>();
        try
        {
            await using var session = DocumentStore.QuerySession();
            var stream = await session.Events.FetchStreamAsync(streamId);
            if (stream == null)
                return events;

            foreach (var evt in stream)
            {
                var eventData = evt.Data;
                var json = eventData != null
                    ? StateSerializer.Serialize(eventData)
                    : "{}";
                events.Add(new MartenEvent(
                    evt.Sequence,
                    evt.EventType?.Name ?? eventData?.GetType().Name ?? "Unknown",
                    FormatJson(json),
                    evt.Timestamp.UtcDateTime
                ));
            }
        }
        catch
        {
            // Events are optional; don't fail the UI if Marten is unavailable
        }
        return events;
    }

    private async Task CopyStateJson()
    {
        if (_stateJson != null)
            await CopyToClipboard(_stateJson);
    }

    private async Task CopyEvents()
    {
        if (_stateEvents.Count > 0)
        {
            var json = JsonSerializer.Serialize(_stateEvents, new JsonSerializerOptions { WriteIndented = true });
            await CopyToClipboard(json);
        }
    }

    private static string FormatJson(string json)
    {
        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(json);
            return JsonSerializer.Serialize(element, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}
