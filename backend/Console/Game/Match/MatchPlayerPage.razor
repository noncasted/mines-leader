@page "/match/{Id:guid}/players/{UserId:guid}"
@using global::Game.MatchMetrics
@using Meta.Matches

<PageTitle>Match player</PageTitle>
<PageHeader Title="Match player"/>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-16">
        <LucideIcon Name="loader-circle" Size="32" class="animate-spin text-primary"/>
    </div>
    return;
}

@if (_card == null || _series == null)
{
    <div class="container mx-auto max-w-5xl px-4 py-4">
        <BbAlert Variant="AlertVariant.Danger">
            <ChildContent>
                <BbAlertTitle>Not Found</BbAlertTitle>
                <BbAlertDescription>User @UserId is not a participant of match @Id</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    </div>
    return;
}

<div class="container mx-auto max-w-5xl px-4 py-4 flex flex-col gap-6">

    <div class="rounded-lg border p-6 flex items-center gap-8">
        <div class="flex flex-col gap-1">
            <span class="text-xs text-muted-foreground uppercase tracking-wide">Player</span>
            <span class="text-sm font-medium">@(_card.Nickname == "" ? UserId.ToString() : _card.Nickname)</span>
        </div>
        <div class="flex flex-col gap-1">
            <span class="text-xs text-muted-foreground uppercase tracking-wide">Result</span>
            <span class="text-sm font-medium">@(_card.IsWinner ? "Winner" : "--") (@_card.RatingChange.ToString("+0;-0;0"))</span>
        </div>
        <div class="flex flex-col gap-1">
            <span class="text-xs text-muted-foreground uppercase tracking-wide">Streams</span>
            <span class="text-sm font-medium">@_card.Streams</span>
        </div>
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                  @onclick="@(() => Navigation.NavigateTo(string.Format(GameConsoleConstants.Pages.Match, Id)))">
            Back to the match
        </BbButton>
    </div>

    <div class="grid grid-cols-3 gap-4 rounded-lg border p-4">
        <MatchAmountList Title="Cells opened" Total="@_card.CellsOpened" Amounts="@_card.CellsBySource"/>
        <MatchAmountList Title="Counters" Total="@null" Amounts="@_card.Counters"/>
        <MatchAmountList Title="Cards played" Total="@_card.CardsPlayed" Amounts="@_card.CardsByType"/>
    </div>

    <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Events</h3>
    <div class="rounded-lg border">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b bg-muted/50">
                <th class="h-9 px-4 text-left font-medium text-muted-foreground">Time, s</th>
                <th class="h-9 px-4 text-left font-medium text-muted-foreground">Event</th>
                <th class="h-9 px-4 text-left font-medium text-muted-foreground">Fields</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var moment in _card.Events)
            {
                <MatchPlayerEventRow Moment="@moment"/>
            }
            </tbody>
        </table>
    </div>

    <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Series by 10 s of the match clock</h3>
    <div class="rounded-lg border">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b bg-muted/50">
                <th class="h-9 px-4 text-left font-medium text-muted-foreground">Series</th>
                <th class="h-9 px-4 text-left font-medium text-muted-foreground">Points (time: value)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var line in _series.Lines)
            {
                <MatchSeriesLineRow Line="@line"/>
            }
            </tbody>
        </table>
    </div>

</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid UserId { get; set; }

    [Inject] public IMatchSummaryCollection Summaries { get; set; } = null!;
    [Inject] public IMatchMetricsReader MetricsReader { get; set; } = null!;
    [Inject] public NavigationManager Navigation { get; set; } = null!;
    [Inject] public ToastService ToastService { get; set; } = null!;

    private bool _isLoading = true;
    private MatchPlayerCard? _card;
    private MatchPlayerSeries? _series;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Load();
        }
        catch (Exception ex)
        {
            ToastService.Error($"[Match] Error loading the player: {ex.Message}", "Error");
        }

        _isLoading = false;
    }

    private async Task Load()
    {
        if (Summaries.TryGetValue(Id, out var match) == false || match.IsPlayer(UserId) == false)
            return;

        var cards = await new MatchPlayerCards(MetricsReader).Get(Id, match);
        _card = cards.Single(card => card.UserId == UserId);
        _series = await new MatchPlayerSeriesReader(MetricsReader).Get(Id, match, UserId, MatchMetricStep.TenSeconds, MatchMetricAxis.Run);
    }
}
