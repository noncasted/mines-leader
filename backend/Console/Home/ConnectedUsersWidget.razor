@using Cluster.Deploy
@using Cluster.Monitoring
@using global::Common.Extensions
@using global::Common.Reactive
@using Meta.Users
@inherits UiComponent

<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Online</h2>
        <span class="text-xs text-muted-foreground">@_users.Count connected</span>
    </div>

    @if (_users.Count == 0)
    {
        <span class="text-xs text-muted-foreground">No users connected</span>
    }
    else
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var user in _users)
            {
                var name = ResolveName(user.UserId);
                <div class="flex items-center gap-1.5 rounded-md border px-2 py-1">
                    <div class="w-1.5 h-1.5 rounded-full bg-green-400"></div>
                    <span class="text-xs font-medium">@name</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] public IDeploymentState<ConnectedUsersLiveData> LiveData { get; set; } = null!;
    [Inject] public IUserCollection UserCollection { get; set; } = null!;

    private List<ConnectedUserEntry> _users = [];

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        LiveData.View(lifetime, data => {
            _users = data.AllUsers();
            InvokeAsync(StateHasChanged).NoAwait();
        });

        return Task.CompletedTask;
    }

    private string ResolveName(Guid userId)
    {
        if (UserCollection.TryGetValue(userId, out var user))
            return user.Name;
        return userId.ToString()[..8] + "...";
    }
}
