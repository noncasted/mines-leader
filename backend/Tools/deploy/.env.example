# Copy to .env for local smoke tests, or set these in the Coolify UI for production deploys.

# === Database (external Postgres) ===
# Host is the Coolify-internal DNS name or any reachable Postgres host.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=minesleader
DB_USER=minesleader
DB_PASSWORD=change-me

# === Application tokens ===
# Console login token (required for /login?token= deep link).
CONSOLE_TOKEN=change-me

# Public URL for the game gateway that clients connect to.
GAME_SERVER_URL=https://game.yourdomain.com

# === Aspire dashboard (optional; enabled with --profile with-dashboard) ===
ASPIRE_TOKEN=change-me
# Shared secret services use to push OTLP to the dashboard. Any random string.
OTEL_API_KEY=change-me-to-random-string

# === Coolify-specific (auto-injected by Coolify — do not set manually locally) ===
# SERVICE_FQDN_META_8080=https://meta.yourdomain.com
# SERVICE_FQDN_GAME_8080=https://game.yourdomain.com
# SERVICE_FQDN_CONSOLE_8080=https://console.yourdomain.com
# SERVICE_FQDN_ASPIREDASHBOARD_18888=https://aspire.yourdomain.com
