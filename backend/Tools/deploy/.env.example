# Copy to .env.local for local smoke tests, or set these in the Coolify UI for production deploys.
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, CONSOLE_TOKEN, GAME_SERVER_URL, ASPIRE_TOKEN and
# OTEL_API_KEY are required: compose refuses to start when one of them is missing or empty.

# === Database (external Postgres) ===
# Host is the Coolify-internal DNS name or any reachable Postgres host.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=minesleader
DB_USER=minesleader
DB_PASSWORD=change-me

# === Orleans cluster identity (optional) ===
# Default "mines-leader". Must differ for every game / environment that shares one Postgres.
# ORLEANS_CLUSTER_ID=mines-leader
# ORLEANS_SERVICE_ID=mines-leader

# === Application tokens ===
# Console login token (/login?token=). Also guards the internal endpoints of meta
# (/api/monitor/*) and game (/api/sessions/*): send "Authorization: Bearer <token>".
# Empty or "local-dev-token" -> console, meta and game fail at startup outside Development.
CONSOLE_TOKEN=change-me

# Browser origins the WebGL client is served from (CORS + WebSocket handshake), comma-separated,
# scheme://host[:port]. Default when unset: https://minesleader.xyz,https://play.minesleader.xyz,https://html-classic.itch.zone
# A native client (Unity editor) sends no Origin and is not affected.
# CORS_ALLOWED_ORIGINS=https://minesleader.xyz,https://play.minesleader.xyz,https://html-classic.itch.zone

# Public URL for the game gateway that clients connect to.
GAME_SERVER_URL=https://game.yourdomain.com

# === Aspire dashboard ===
# Browser login token of the dashboard (it has a public domain).
ASPIRE_TOKEN=change-me
# Shared secret services use to push OTLP to the dashboard. Any random string.
OTEL_API_KEY=change-me-to-random-string

# === Coolify-specific (auto-injected by Coolify — do not set manually locally) ===
# SERVICE_FQDN_META_8080=https://meta.yourdomain.com
# SERVICE_FQDN_GAME_8080=https://game.yourdomain.com
# SERVICE_FQDN_CONSOLE_8080=https://console.yourdomain.com
# SERVICE_FQDN_ASPIREDASHBOARD_18888=https://aspire.yourdomain.com
