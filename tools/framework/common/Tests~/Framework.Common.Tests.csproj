<Project Sdk="Microsoft.NET.Sdk">

    <!-- xunit v3 on the Microsoft Testing Platform: run the executable (dotnet test refuses on the .NET 10 SDK). -->
    <PropertyGroup>
        <AssemblyName>Framework.Common.Tests</AssemblyName>
        <RootNamespace>Framework.Common.Tests</RootNamespace>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="FluentAssertions"/>
    </ItemGroup>

    <!-- ReactiveExceptions.Handler is a process-wide hook: the tests that install it must not overlap with the ones
         that expect the rethrow without it. -->
    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\framework.common.csproj"/>
    </ItemGroup>

</Project>
