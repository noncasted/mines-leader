@using Cluster.State
@using global::Common.Extensions
@using global::Internal
@inherits UiComponent

<div class="flex flex-col gap-3">
    <h2 class="text-sm font-semibold">Status</h2>
    <div class="grid grid-cols-3 gap-3">
        <StartupStatusTile />
        <FeatureStatusTile Label="Connections" Value="_state.AcceptingConnections" />
        <FeatureStatusTile Label="Side Effects" Value="_state.SideEffectsEnabled" />

        @foreach (var flag in GameFlags)
        {
            <FeatureStatusTile Label="@flag.StatusLabel" Value="_state.GameFlags.TryGetValue(flag.Name, out var enabled) && enabled" />
        }
    </div>
</div>

@code {
    [Inject] private IClusterFeatures ClusterFeatures { get; set; } = null!;
    [Inject] private IEnumerable<ConsoleGameFlag> GameFlags { get; set; } = null!;

    private ClusterFeaturesState _state = new();

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        ClusterFeatures.View(lifetime, state =>
        {
            _state = state;
            InvokeAsync(StateHasChanged).NoAwait();
        });

        return Task.CompletedTask;
    }
}
