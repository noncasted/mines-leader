@using Cluster.Coordination
@using Cluster.Discovery
@using global::Common.Extensions
@using global::Internal
@inherits UiComponent

<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Cluster</h2>
        <span class="text-xs text-muted-foreground">@_services.Count services</span>
    </div>

    <div class="grid grid-cols-5 gap-2">
        @foreach (var tag in StartupConfig.RequiredServices)
        {
            var ofRole = _byRole.GetValueOrDefault(tag, []);
            <ClusterRoleTile Tag="tag" Count="ofRole.Count" Health="ServiceHealthRules.OfRole(ofRole, _refreshedAt)"/>
        }
    </div>

    @if (_staleServices.Count > 0)
    {
        <div class="text-xs text-amber-500">
            @_staleServices.Count stale service(s) detected
        </div>
    }
</div>

@code {
    [Inject] private IServiceDiscovery ServiceDiscovery { get; set; } = null!;
    [Inject] private IClusterStartupConfig StartupConfig { get; set; } = null!;

    private IReadOnlyList<IServiceOverview> _services = [];
    private Dictionary<ServiceTag, IReadOnlyList<IServiceOverview>> _byRole = new();
    private List<IServiceOverview> _staleServices = new();
    private DateTime _refreshedAt;

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        RefreshLoop(lifetime).NoAwait();
        return Task.CompletedTask;
    }

    // IServiceDiscovery has no observable of its entries, so the page reads them every 5 s.
    private async Task RefreshLoop(IReadOnlyLifetime lifetime)
    {
        while (lifetime.IsTerminated == false)
        {
            Refresh();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(5000, lifetime.Token);
        }
    }

    private void Refresh()
    {
        _refreshedAt = DateTime.UtcNow;
        _services = ServiceDiscovery.Entries.Values.ToList();
        _byRole = _services.GroupBy(s => s.Tag).ToDictionary(g => g.Key, g => (IReadOnlyList<IServiceOverview>)g.ToList());
        _staleServices = _services.Where(s => ServiceHealthRules.Of(s, _refreshedAt) != ServiceHealth.Healthy).ToList();
    }
}
