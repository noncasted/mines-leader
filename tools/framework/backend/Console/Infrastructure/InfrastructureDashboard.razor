@page "/infrastructure"
@using Game.ClientTelemetry

<PageTitle>Infrastructure</PageTitle>

<div class="h-full px-6 py-8">
    <div class="flex gap-8 h-full">
        <div class="w-1/2">
            <HomeSection Title="Infrastructure">
                @foreach (var card in ProjectCards)
                {
                    <HomeNavCard Icon="@card.Icon" Title="@card.Title" Description="@card.Description" Target="@card.Target" />
                }

                <HomeNavCard
                    Icon="server"
                    Title="Options"
                    Description="Tune task balancer, side effects and messaging settings"
                    Target="@ConsoleConstants.Pages.InfrastructureOptions" />

                <HomeNavCard
                    Icon="toggle-right"
                    Title="Features"
                    Description="Toggle cluster features: connections, side effects"
                    Target="@ConsoleConstants.Pages.Features" />

                <HomeNavCard
                    Icon="users"
                    Title="Online"
                    Description="Users online now, peak and unique users by hour and by day"
                    Target="@ConsoleConstants.Pages.Online" />

                <HomeNavCard
                    Icon="activity"
                    Title="Side Effects"
                    Description="Monitor side effects pipeline: queue depths, retry entries, manual requeue"
                    Target="@ConsoleConstants.Pages.SideEffects" />

                <HomeNavCard
                    Icon="radar"
                    Title="Discovery"
                    Description="Cluster services, health status and last heartbeat times"
                    Target="@ConsoleConstants.Pages.Discovery" />

                <HomeNavCard
                    Icon="rocket"
                    Title="Deploy"
                    Description="Current deploy id and cleanup of stale deploy state records"
                    Target="@ConsoleConstants.Pages.Deploy" />

                <HomeNavCard
                    Icon="database"
                    Title="State Explorer"
                    Description="Read raw grain state from PostgreSQL by type and key"
                    Target="@ConsoleConstants.Pages.StateExplorer" />

                <HomeNavCard
                    Icon="scroll-text"
                    Title="Audit Log"
                    Description="Track admin actions and configuration changes"
                    Target="@ConsoleConstants.Pages.AuditLog" />

                <HomeNavCard
                    Icon="memory-stick"
                    Title="Monitoring"
                    Description="Collect heap snapshots from all cluster services and download memory reports"
                    Target="@ConsoleConstants.Pages.Monitoring" />

                @if (TelemetryReaders.Any())
                {
                    <HomeNavCard
                        Icon="gauge"
                        Title="Client Telemetry"
                        Description="Sessions of the game clients: FPS, memory, errors over time"
                        Target="@ConsoleConstants.Pages.ClientTelemetry" />
                }
            </HomeSection>
        </div>
    </div>
</div>

@code {
    // Cards of the project (AddConsoleInfrastructureCard) come first.
    [Inject] private IEnumerable<ConsoleInfrastructureCard> ProjectCards { get; set; } = null!;

    // Empty on the console of a game without the telemetry (AddClientTelemetryReader registers it).
    [Inject] private IEnumerable<IClientTelemetryReader> TelemetryReaders { get; set; } = null!;
}
