@using Cluster.Monitoring.Online

<tr class="border-b last:border-b-0 hover:bg-muted/30">
    <td class="px-4 py-2.5 text-xs font-medium">@OnlinePeriodFormat.Day(Period)</td>
    <td class="px-4 py-2.5 text-xs text-right">@Period.Peak</td>
    <td class="px-4 py-2.5 text-xs text-right">@Period.UniqueUsers</td>
</tr>

@code {
    [Parameter, EditorRequired] public required OnlinePeriod Period { get; set; }
}
