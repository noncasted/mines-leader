@using global::Infrastructure
<div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
    <div class="flex items-center gap-2">
        <div class="rounded-md bg-blue-500/15 p-1.5">
            <LucideIcon Name="mail" Size="14" class="text-blue-400" />
        </div>
        <h2 class="text-sm font-semibold">Durable Queue</h2>
    </div>
    <div class="flex flex-col">
        <OptionNumberRow Icon="clock" Label="Observer Keep-Alive (minutes)" Value="Value.ObserverKeepAliveMinutes"
                         Changed="v => ValueChanged.InvokeAsync(Value with { ObserverKeepAliveMinutes = v })"/>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DurableQueueOptions Value { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback<DurableQueueOptions> ValueChanged { get; set; }
}
