@using global::Infrastructure
<div class="rounded-lg border bg-card p-4 flex flex-col gap-3">
    <div class="flex items-center gap-2">
        <div class="rounded-md bg-blue-500/15 p-1.5">
            <LucideIcon Name="arrow-left-right" Size="14" class="text-blue-400" />
        </div>
        <h2 class="text-sm font-semibold">Transactions</h2>
    </div>
    <div class="flex flex-col">
        <OptionNumberRow Icon="timer" Label="Lock Wait (sec)" Value="Value.LockWaitSeconds"
                         Changed="v => ValueChanged.InvokeAsync(Value with { LockWaitSeconds = v })" Step="0.5"/>
        <OptionNumberRow Icon="clock" Label="Stuck Grace Period (sec)" Value="Value.StuckGraceSeconds"
                         Changed="v => ValueChanged.InvokeAsync(Value with { StuckGraceSeconds = v })" Step="1"/>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TransactionOptions Value { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback<TransactionOptions> ValueChanged { get; set; }
}
