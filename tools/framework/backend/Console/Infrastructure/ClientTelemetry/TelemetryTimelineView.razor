<div class="rounded-lg border bg-card p-4 flex flex-col gap-2">
    <div class="flex items-center justify-between gap-2" style="@TelemetryLayoutStyle.Wrap">
        <span class="text-sm font-medium">Timeline</span>
        <div class="flex items-center gap-4 text-xs text-muted-foreground">
            <span><span style="color: var(--destructive)">|</span> errors</span>
            <span><span style="color: var(--muted-foreground)">¦</span> marks</span>
            <span class="flex items-center gap-2"><svg width="16" height="10"><rect width="16" height="10" style="@TelemetrySessionChartStyle.HiddenFill"/></svg> page in the background: dashed, out of the summary</span>
        </div>
    </div>
    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" style="width: 100%; height: 2.5rem">
        @foreach (var span in HiddenSpans)
        {
            <rect x="@X(span.From)" y="0" width="@Number(Math.Max(Geometry.X(span.To) - Geometry.X(span.From), TelemetrySessionChartStyle.MinHiddenWidth))" height="40" style="@TelemetrySessionChartStyle.HiddenFill"/>
        }
        @foreach (var tick in Timeline.Ticks)
        {
            <line x1="@X(tick.Time)" x2="@X(tick.Time)" y1="@TickTop(tick)" y2="@(TickTop(tick) + 20)" vector-effect="non-scaling-stroke"
                  stroke-dasharray="@TelemetrySessionChartStyle.TickDash(tick.Kind)"
                  style="stroke: @TelemetrySessionChartStyle.TickColor(tick.Kind); stroke-width: 3">
                <title>@TelemetryValueFormat.Time(tick.Time) x@(tick.Count): @tick.Label</title>
            </line>
        }
    </svg>
    <div class="flex justify-between text-xs text-muted-foreground">
        @foreach (var time in Timeline.Axis(AxisParts))
        {
            <span>@TelemetryValueFormat.Time(time)</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required TelemetryTimeline Timeline { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<TelemetryHiddenSpan> HiddenSpans { get; set; }

    private const int AxisParts = 6;

    private TelemetryChartGeometry Geometry => new(Timeline.End, 0, 1);

    private string X(long time) => Number(Geometry.X(time));
    private static string Number(double value) => TelemetryChartGeometry.Number(value);
    private static int TickTop(TelemetryTimelineTick tick) => tick.Kind == TelemetryTimelineKind.Mark ? 0 : 20;
}
