@using Game.ClientTelemetry

<tr class="border-b last:border-b-0 hover:bg-muted/30">
    <td class="px-4 py-1 text-xs">
        <div class="flex items-center gap-2" style="padding-left: @(Span.Depth * IndentRem)rem; @(HasChildren ? "cursor: pointer" : "")" title="@Span.Name" @onclick="Toggle">
            <span class="text-muted-foreground" style="width: 0.75rem">@(HasChildren ? (IsExpanded ? "▼" : "▶") : "")</span>
            <span class="break-all">@Span.Name</span>
            @if (Span.Unfinished)
            {
                <span class="text-muted-foreground">unfinished</span>
            }
        </div>
    </td>
    <td class="px-4 py-1 text-xs text-right whitespace-nowrap">@TelemetryValueFormat.Milliseconds(Span.OwnMs)</td>
    <td class="px-4 py-1 text-xs text-right whitespace-nowrap text-muted-foreground">@TelemetryValueFormat.Milliseconds(Span.DurationMs)</td>
    <td class="px-4 py-1 text-xs text-right whitespace-nowrap text-muted-foreground">@Span.Frames</td>
    @if (ShowAllocations)
    {
        <td class="px-4 py-1 text-xs text-right whitespace-nowrap text-muted-foreground">@TelemetryValueFormat.Value(Span.AllocBytes, "bytes")</td>
    }
    <td class="px-4 py-1" style="width: 45%; min-width: 16rem">
        <svg viewBox="0 0 1000 10" preserveAspectRatio="none" style="display: block; width: 100%; height: 0.875rem">
            @foreach (var part in Enumerable.Range(1, TelemetryStartupStyle.AxisParts - 1))
            {
                <line x1="@Number(part * 1000d / TelemetryStartupStyle.AxisParts)" x2="@Number(part * 1000d / TelemetryStartupStyle.AxisParts)" y1="0" y2="10" vector-effect="non-scaling-stroke" style="@TelemetryStartupStyle.GridLine"/>
            }
            <rect x="@Number(Left)" y="1" width="@Number(Width)" height="8" style="@TelemetryStartupStyle.Bar(Span.Depth, Span.Unfinished)">
                <title>@Span.Name&#10;start @TelemetryValueFormat.Milliseconds(Span.StartMs)&#10;duration @TelemetryValueFormat.Milliseconds(Span.DurationMs)&#10;own @TelemetryValueFormat.Milliseconds(Span.OwnMs)&#10;frames @Span.Frames</title>
            </rect>
        </svg>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public required TelemetryStartupSpanFacts Span { get; set; }
    [Parameter, EditorRequired] public required double ScaleMs { get; set; }
    [Parameter] public bool HasChildren { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public bool ShowAllocations { get; set; }
    [Parameter] public EventCallback<int> OnToggle { get; set; }

    private const double IndentRem = 0.875;
    private const double MinWidth = 1.5;

    private double Left => Span.StartMs / ScaleMs * 1000;
    private double Width => Math.Max(MinWidth, Span.DurationMs / ScaleMs * 1000);

    private static string Number(double value) => TelemetryChartGeometry.Number(value);

    private Task Toggle()
    {
        return HasChildren ? OnToggle.InvokeAsync(Span.Index) : Task.CompletedTask;
    }
}
