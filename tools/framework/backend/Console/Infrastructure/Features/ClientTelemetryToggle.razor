@using Game.ClientTelemetry
@using global::Common.Extensions
@using global::Internal
@inherits UiComponent

<div class="rounded-lg border bg-card p-6 flex flex-col gap-4">
    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider border-b pb-2">Client telemetry</h2>

    <FeatureToggle
        Label="Client Telemetry"
        Description="Take the telemetry of the game clients. Survives a deploy and a restart of the cluster"
        Value="Switch.IsEnabled"
        OnToggle="OnToggle"
        Saving="Saving || !Switch.IsLoaded" />
</div>

@code {
    [Parameter, EditorRequired] public required IClientTelemetrySwitch Switch { get; set; }
    [Parameter, EditorRequired] public EventCallback OnToggle { get; set; }
    [Parameter, EditorRequired] public bool Saving { get; set; }

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        Switch.View(lifetime, () => InvokeAsync(StateHasChanged).NoAwait());

        return Task.CompletedTask;
    }
}
