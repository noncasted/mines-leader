<Project Sdk="Microsoft.NET.Sdk">

    <!-- The telemetry of game clients: the handling of its messages on the meta socket, with the limits and the privacy rules
         (closed list of the device, names of the metrics and tags, Scrubber over the texts of errors), a grain per session that
         holds the data in memory and writes two states (the start; the summary and the whole log at the close), the endpoints
         of the reading. -->
    <PropertyGroup>
        <AssemblyName>Framework.ClientTelemetry</AssemblyName>
        <RootNamespace>Game.ClientTelemetry</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk"/>
        <PackageReference Include="Newtonsoft.Json"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <InternalsVisibleTo Include="Framework.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\shared\framework.shared.csproj"/>
        <ProjectReference Include="..\..\common\framework.common.csproj"/>
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj"/>
    </ItemGroup>

</Project>
