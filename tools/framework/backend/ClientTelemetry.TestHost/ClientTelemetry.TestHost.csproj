<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- A process for the end to end checks of the client telemetry: a real Kestrel on a port, a silo over its own PostgreSQL
         container, the real switch. Built on the fixtures of the tests; no game and no production build references it.
         tools/scripts/test-telemetry-transport.sh runs it around the PlayMode test, see CLAUDE.md, Tests. -->
    <PropertyGroup>
        <AssemblyName>Framework.ClientTelemetry.TestHost</AssemblyName>
        <RootNamespace>Framework.ClientTelemetry.TestHost</RootNamespace>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <!-- The packages of the tests come through the reference: this process has its own Main. -->
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets"/>
        <PackageReference Include="BlazorBlueprint.Components"/>
        <PackageReference Include="BlazorBlueprint.Primitives"/>
        <PackageReference Include="BlazorBlueprint.Icons.Lucide"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tests\Tests.csproj"/>
        <ProjectReference Include="..\ClientTelemetry\ClientTelemetry.csproj"/>
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj"/>
        <ProjectReference Include="..\Cluster\Cluster.csproj"/>
        <ProjectReference Include="..\Console\Console.csproj"/>
        <ProjectReference Include="..\Session\Session.csproj"/>
        <ProjectReference Include="..\Hosting\Hosting.csproj"/>
        <ProjectReference Include="..\..\shared\framework.shared.csproj"/>
        <ProjectReference Include="..\..\shared\SessionCore\framework.session.core.csproj"/>
        <ProjectReference Include="..\..\common\framework.common.csproj"/>
    </ItemGroup>

</Project>
