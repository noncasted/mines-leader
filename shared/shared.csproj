<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
        <AssemblyName>Shared</AssemblyName>
        <RootNamespace>Shared</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="**\*.meta"/>
        <Content Remove="**\*.meta"/>
        <None Remove=".editorconfig"/>
        <None Remove="**\*.asmdef"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MemoryPack" Version="1.21.4"/>
        <PackageReference Include="MemoryPack.UnityShims" Version="1.21.4"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    </ItemGroup>

    <ItemGroup>
        <EditorConfigFiles Remove="Backend\.editorconfig"/>
        <EditorConfigFiles Remove="Domain\.editorconfig"/>
        <EditorConfigFiles Remove="Game\.editorconfig"/>
        <EditorConfigFiles Remove="Protocol\.editorconfig"/>
        <EditorConfigFiles Remove="Session\.editorconfig"/>
    </ItemGroup>

</Project>
