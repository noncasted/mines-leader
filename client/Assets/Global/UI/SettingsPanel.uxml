<UXML xmlns="UnityEngine.UIElements" xmlns:t="Global.UI.Toolkit" editor-extension-mode="False">
    <Style src="project://database/Assets/Menu/UI/Styles/MenuTheme.uss?fileID=7433441132597879392&amp;guid=0343b35e0706debdc94c1025e64deaf7&amp;type=3#MenuTheme"/>

    <VisualElement name="settings-overlay" class="settings-overlay">
        <VisualElement class="panel settings-panel">
            <VisualElement class="panel-mid">
                <VisualElement class="panel-highlight" />
                <VisualElement class="panel-header-upper" />
                <VisualElement class="panel-header-lower" />

                <VisualElement class="panel-body">
                    <Label text="Settings" class="settings-title" />
                    <VisualElement class="settings-divider" />

                    <Label text="Audio" class="settings-section-label" />

                    <VisualElement class="settings-row">
                        <Label text="Master Volume" class="settings-row-label" />
                        <Slider name="slider-master" low-value="0" high-value="1" class="settings-slider" />
                    </VisualElement>

                    <VisualElement class="settings-row">
                        <Label text="Sound Effects" class="settings-row-label" />
                        <Slider name="slider-sounds" low-value="0" high-value="1" class="settings-slider" />
                    </VisualElement>

                    <VisualElement class="settings-row">
                        <Label text="Music" class="settings-row-label" />
                        <Slider name="slider-music" low-value="0" high-value="1" class="settings-slider" />
                    </VisualElement>

                    <VisualElement class="settings-divider" />
                    <Label text="Effects" class="settings-section-label" />

                    <VisualElement class="settings-row">
                        <Label text="Shake" class="settings-row-label" />
                        <Slider name="slider-shake" low-value="0" high-value="1" class="settings-slider" />
                    </VisualElement>

                    <VisualElement class="settings-divider" />
                    <Label text="Video" class="settings-section-label" />

                    <VisualElement class="settings-row">
                        <Label text="VSync" class="settings-row-label" />
                        <VisualElement class="settings-toggle-group">
                            <Button name="btn-vsync-on" text="On" class="settings-toggle-btn" />
                            <Button name="btn-vsync-off" text="Off" class="settings-toggle-btn" />
                        </VisualElement>
                    </VisualElement>

                    <VisualElement class="settings-buttons">
                        <t:NavButton name="btn-cancel" text="Cancel" />
                        <VisualElement class="separator" />
                        <t:NavButton name="btn-apply" text="Apply" />
                    </VisualElement>
                </VisualElement>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
