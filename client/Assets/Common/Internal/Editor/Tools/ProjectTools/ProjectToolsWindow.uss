.project-tools-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(45, 45, 45);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: rgb(56, 56, 56);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    min-height: 44px;
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    flex-grow: 1;
}

.save-button {
    min-width: 80px;
    height: 24px;
    background-color: rgb(80, 120, 200);
    color: white;
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
}

.save-button:hover {
    background-color: rgb(100, 140, 220);
}

.save-button:active {
    background-color: rgb(60, 100, 180);
}

.tab-bar {
    flex-direction: row;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    padding: 4px;
}

.tab-button {
    flex-grow: 1;
    height: 28px;
    margin: 0 2px;
    background-color: rgb(65, 65, 65);
    color: rgb(180, 180, 180);
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
}

.tab-button:hover {
    background-color: rgb(80, 80, 80);
    color: rgb(210, 210, 210);
}

.tab-button--active {
    background-color: rgb(80, 120, 200);
    color: white;
}

.tab-button--active:hover {
    background-color: rgb(90, 135, 220);
    color: white;
}

.tab-content-wrapper {
    flex-grow: 1;
    padding: 10px;
}

.tab-content {
    flex-grow: 1;
}

.section {
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(40, 40, 40);
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 6px;
}

.scene-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.scene-separator {
    height: 1px;
    background-color: rgb(40, 40, 40);
    margin: 6px 4px;
}

.scene-button {
    min-width: 120px;
    height: 28px;
    margin: 3px;
    background-color: rgb(72, 72, 72);
    color: rgb(200, 200, 200);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(50, 50, 50);
    font-size: 11px;
}

.scene-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(80, 120, 200);
}

.scene-button:active {
    background-color: rgb(60, 60, 60);
}

.scene-button--active {
    background-color: rgb(60, 100, 170);
    border-color: rgb(80, 130, 220);
    color: white;
}

.scene-button--loaded {
    background-color: rgb(50, 75, 115);
    border-color: rgb(70, 105, 165);
    color: rgb(215, 225, 240);
}

.assets-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 10px;
}

.assets-button {
    flex-grow: 1;
    height: 32px;
    margin: 0 4px;
    background-color: rgb(72, 72, 72);
    color: rgb(200, 200, 200);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(50, 50, 50);
    font-size: 12px;
}

.assets-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(80, 120, 200);
}

.assets-button:active {
    background-color: rgb(60, 60, 60);
}

.assets-progress {
    height: 20px;
    margin-bottom: 10px;
}

.assets-run-all-button {
    height: 36px;
    background-color: rgb(80, 120, 200);
    color: white;
    border-radius: 4px;
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
}

.assets-run-all-button:hover {
    background-color: rgb(100, 140, 220);
}

.assets-run-all-button:active {
    background-color: rgb(60, 100, 180);
}

.footer {
    padding: 8px 10px;
    background-color: rgb(56, 56, 56);
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
    min-height: 28px;
    flex-direction: row;
    align-items: center;
}

.status-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
}
