.container-debugger-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(45, 45, 45);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: rgb(56, 56, 56);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    min-height: 44px;
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    flex-grow: 1;
}

.toolbar {
    flex-direction: row;
    align-items: center;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    padding: 4px 8px;
    min-height: 32px;
}

.toolbar-button {
    height: 24px;
    margin-right: 8px;
    background-color: rgb(72, 72, 72);
    color: rgb(200, 200, 200);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(50, 50, 50);
    font-size: 12px;
}

.toolbar-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(80, 120, 200);
}

.history-toggle {
    margin-left: 8px;
    color: rgb(200, 200, 200);
    font-size: 12px;
}

.body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.tree-pane {
    width: 260px;
    flex-shrink: 0;
    flex-grow: 0;
    flex-direction: column;
    background-color: rgb(50, 50, 50);
    border-right-width: 1px;
    border-right-color: rgb(35, 35, 35);
    min-height: 0;
}

.pane-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(180, 180, 180);
    padding: 8px 10px 4px 10px;
}

.container-tree {
    flex-grow: 1;
    min-height: 0;
}

.tree-item {
    font-size: 12px;
    color: rgb(210, 210, 210);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.details-pane {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.details {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
    min-height: 0;
}

.container-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    margin-bottom: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.section {
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(40, 40, 40);
    min-height: 0;
}

.registrations-section {
    flex-grow: 2;
    flex-direction: column;
}

.lower {
    flex-grow: 1;
    flex-direction: row;
    min-height: 140px;
}

.graph-section {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 8px;
    margin-bottom: 0;
}

.build-section {
    flex-grow: 1;
    flex-direction: column;
    margin-bottom: 0;
}

.history-section {
    flex-grow: 1;
    flex-direction: column;
    min-height: 90px;
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 6px;
}

.section-body {
    flex-grow: 1;
    min-height: 0;
}

.table {
    flex-grow: 1;
    min-height: 72px;
}

.table-cell {
    font-size: 11px;
    color: rgb(210, 210, 210);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 2px 4px;
}

.slot-chip {
    height: 22px;
    margin: 2px 0;
    padding: 0 8px;
    background-color: rgb(72, 72, 72);
    color: rgb(200, 200, 200);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(50, 50, 50);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.slot-chip:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(80, 120, 200);
}

.slot-chip--selected {
    background-color: rgb(80, 120, 200);
    color: white;
    border-color: rgb(90, 135, 220);
}

.graph-caption {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(160, 160, 160);
    margin-top: 6px;
    margin-bottom: 2px;
}

.hint {
    font-size: 11px;
    color: rgb(150, 150, 150);
    white-space: normal;
    margin: 2px 0 6px 0;
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgb(160, 160, 160);
    font-size: 13px;
    padding: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.footer {
    padding: 8px 10px;
    background-color: rgb(56, 56, 56);
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
    min-height: 28px;
    flex-direction: row;
    align-items: center;
}

.status-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
}

.status-label--error {
    color: rgb(255, 80, 80);
}
