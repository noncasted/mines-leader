.pause-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
}

.pause-panel {
    width: 200px;
    background-color: rgb(38, 30, 55);
    border-width: 2px;
    border-color: rgb(56, 49, 78);
    padding: 4px;
}

.pause-button {
    height: 28px;
    margin: 2px 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(58, 50, 78);
    color: rgb(148, 138, 148);
    -unity-font-definition: resource("DreiFraktur");
    font-size: 14px;
    -unity-text-align: middle-center;
}

.pause-button:hover {
    background-color: rgb(70, 68, 100);
    color: rgb(200, 200, 210);
}

.pause-button:active {
    background-color: rgb(96, 97, 124);
    color: rgb(255, 255, 255);
}

.leave-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
}

.leave-panel {
    width: 180px;
    background-color: rgb(38, 30, 55);
    border-width: 2px;
    border-color: rgb(56, 49, 78);
    padding: 8px;
}

.leave-label {
    color: rgb(148, 138, 148);
    -unity-font-definition: resource("DreiFraktur");
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.leave-buttons {
    flex-direction: row;
}

.leave-buttons .nav-button {
    flex-grow: 1;
    height: 24px;
    margin: 0 2px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(58, 50, 78);
    color: rgb(148, 138, 148);
    -unity-font-definition: resource("DreiFraktur");
    font-size: 12px;
    -unity-text-align: middle-center;
}

.leave-buttons .nav-button:hover {
    background-color: rgb(70, 68, 100);
    color: rgb(200, 200, 210);
}

.leave-buttons .nav-button:active {
    background-color: rgb(96, 97, 124);
    color: rgb(255, 255, 255);
}
