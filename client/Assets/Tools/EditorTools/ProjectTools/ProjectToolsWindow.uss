.project-tools-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(45, 45, 45);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: rgb(56, 56, 56);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    min-height: 44px;
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    flex-grow: 1;
}

.save-button {
    min-width: 80px;
    height: 24px;
    background-color: rgb(80, 120, 200);
    color: white;
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
}

.save-button:hover {
    background-color: rgb(100, 140, 220);
}

.save-button:active {
    background-color: rgb(60, 100, 180);
}

.content {
    flex-grow: 1;
    padding: 10px;
}

.section {
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(40, 40, 40);
}

.scene-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.scene-button {
    min-width: 120px;
    height: 28px;
    margin: 3px;
    background-color: rgb(72, 72, 72);
    color: rgb(200, 200, 200);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(50, 50, 50);
    font-size: 11px;
}

.scene-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(80, 120, 200);
}

.scene-button:active {
    background-color: rgb(60, 60, 60);
}

.scene-button--active {
    background-color: rgb(60, 100, 170);
    border-color: rgb(80, 130, 220);
    color: white;
}

.footer {
    padding: 8px 10px;
    background-color: rgb(56, 56, 56);
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
    min-height: 28px;
    flex-direction: row;
    align-items: center;
}

.status-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
}
