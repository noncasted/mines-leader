.cards-root {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0 24px 8px 24px;
    background-image: url("project://database/Assets/Menu/Artowork/Deck/background_blue.psd?fileID=21300000&guid=20d641ed5dd3a5d41b038b0b7f44750e&type=3#background_blue");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.cards-header-left {
    position: absolute;
    left: 24px;
    top: 16px;
    flex-direction: row;
    align-items: center;
}

.cards-header-center {
    align-self: center;
    align-items: center;
    margin-top: 0;
    margin-bottom: 4px;
}

.header-content-row {
    flex-direction: row;
    align-items: center;
}

.cards-header-right {
    flex-direction: column;
    align-items: flex-end;
}

.header-line {
    height: 1px;
    background-color: rgba(120, 118, 150, 0.6);
    margin-top: 4px;
    align-self: stretch;
}

.avg-label {
    font-size: 28px;
    color: var(--color-text-accent);
    margin-right: 8px;
}

.mana-orb {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/Menu/Artowork/mana_icon.psd?fileID=21300000&guid=f3b4745234aa2784f84169ece2f96e8d&type=3#mana_icon");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 6px;
}

.avg-value {
    font-size: 28px;
    color: var(--color-text-accent);
}

.deck-label {
    font-size: 28px;
    color: var(--color-text-accent);
}

.deck-index-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.deck-index-btn {
    width: 40px;
    height: 40px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(130, 130, 145);
    color: rgb(25, 20, 50);
    font-size: 49px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Resources/Ithaca-LVB75.ttf?fileID=12800000&guid=0e6fcbe965852adfcb4fe75ea390dc48&type=3#Ithaca-LVB75");
}

.deck-index-btn:hover {
    background-color: var(--color-panel-header-lower);
    color: var(--color-text-accent);
}

.deck-index-btn.active {
    background-color: var(--color-panel-header-upper);
    border-color: var(--color-panel-highlight);
    color: var(--color-text-accent);
}

.deck-slots {
    flex-direction: row;
    justify-content: center;
    min-height: 60px;
    margin-bottom: 8px;
}

.card-element {
    width: 168px;
    height: 192px;
    margin: 0 4px;
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
    margin-right: 0;
    margin-left: 0;
}

.card-element.drag-hover {
    overflow: visible;
}

.card-glow {
    display: none;
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    -unity-background-scale-mode: stretch-to-fill;
    picking-mode: ignore;
}

.card-element.drag-hover .card-glow {
    display: flex;
}

.card-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0%;
    -unity-background-scale-mode: scale-to-fit;
}

.card-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Menu/Artowork/Deck/card_plate.psd?fileID=21300000&guid=34365009c4e0baa4ebe987b5e2db8c6a&type=3#card_plate");
    -unity-background-scale-mode: stretch-to-fill;
    picking-mode: ignore;
}

.card-mana {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    font-size: 12px;
    color: var(--color-text-accent);
    -unity-text-align: middle-center;
}

.card-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    padding: 0 8px;
}

.card-name-row {
    display: none;
}

.card-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0%;
    height: 12px;
    font-size: 10px;
    color: rgb(207, 182, 153);
    -unity-text-align: middle-center;
    overflow: hidden;
    bottom: 0;
    -unity-font-definition: resource("Ithaca-LVB75");
    align-self: center;
    align-items: center;
}

.card-desc {
    font-size: 8px;
    color: rgb(90, 70, 50);
    white-space: normal;
    overflow: hidden;
    flex-grow: 1;
    -unity-text-align: upper-center;
    padding: 2px 4px;
}

.pool-card {
    margin: 3px;
}

.pool-card.unowned {
    opacity: 0.15;
}

.pool-card.in-deck {
    display: none;
}

.cards-divider {
    height: 2px;
    background-color: rgba(120, 118, 150, 0.4);
    margin: 4px 0 8px 0;
}

.pool-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-width: 1000px;
    align-self: center;
}

.pool-scroll #unity-content-viewport {
    padding: 0;
    margin: 0;
}

.pool-scroll #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
}

.pool-scroll .unity-scroller--vertical {
    width: 18px;
}

.pool-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background-image: url("project://database/Assets/Menu/Artowork/Deck/slider_back.psd?fileID=21300000&guid=246106d3f7500f8438c9f3b2c146a4be&type=3#slider_back");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    width: 18px;
    margin: 0;
}

.pool-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-image: url("project://database/Assets/Menu/Artowork/Deck/slider.psd?fileID=21300000&guid=447867597cfe24e488ab0adf203dae3a&type=3#slider");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    width: 18px;
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    margin: 0;
}

.pool-scroll .unity-repeat-button {
    display: none;
}

.drag-ghost {
    position: absolute;
    width: 126px;
    height: 144px;
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
    opacity: 0.85;
}

.exit-btn {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 80px;
    height: 80px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Menu/Artowork/Deck/exit_button.psd?fileID=21300000&guid=1c5ff2a614df2c94db5c2c7a26afa196&type=3#exit_button");
    -unity-background-scale-mode: scale-to-fit;
}

.exit-btn:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.exit-btn:active {
    -unity-background-image-tint-color: rgb(180, 180, 180);
}
