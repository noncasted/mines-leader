<UXML xmlns="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Menu/UI/Decks/MenuCards.uss?fileID=7433441132597879392&amp;guid=ecb5f2dd60030d006a87532c59b7847c&amp;type=3#MenuCards"/>
    <Style src="project://database/Assets/Menu/UI/Styles/MenuTheme.uss?fileID=7433441132597879392&amp;guid=0343b35e0706debdc94c1025e64deaf7&amp;type=3#MenuTheme"/>
    <VisualElement name="card-root" class="card-element">
        <VisualElement name="card-glow" class="card-glow"/>
        <VisualElement name="card-image" style="position: absolute; -unity-background-scale-mode: scale-to-fit; background-image: resource(&quot;Cards/Bloodhound&quot;); left: 0; bottom: 25px; right: 0; top: 2px; width: 100%; align-self: stretch;"/>
        <VisualElement name="card-frame" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-image: resource(&quot;Menu/card_plate&quot;); -unity-background-scale-mode: stretch-to-fill; picking-mode: ignore;">
            <Label name="card-info" text="Clears and reveals all cells in a diamond area on your field." class="u-ithaca" style="position: absolute; height: 16px; right: 5px; bottom: 2px; left: 5px; white-space: normal; font-size: 4px; -unity-text-align: middle-center; color: rgb(38, 38, 38); align-self: center; margin: 0; padding: 0 2px;"/>
            <Label name="card-name" text="Bloodhound" class="u-ithaca" style="position: absolute; color: rgb(207, 182, 153); -unity-text-align: middle-center; overflow: hidden; height: 5px; width: 80%; top: 24px; right: 0; left: 4px; font-size: 6px; margin: 0; padding: 0; align-items: center; align-self: center; align-content: center; flex-shrink: 0;"/>
        </VisualElement>
        <Label name="card-mana" text="3" style="position: absolute; top: 2px; right: 5px; height: 7px; width: 6px; -unity-font-definition: resource(&quot;BITACH&quot;); color: rgb(55, 244, 255); align-content: center; justify-content: center; align-items: stretch; -unity-text-align: middle-center; font-size: 5px; margin: 0; padding: 0;"/>
    </VisualElement>
</UXML>
