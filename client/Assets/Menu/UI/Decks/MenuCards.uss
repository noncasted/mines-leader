.deck-index-btn {
    width: 11px;
    height: 11px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(130, 130, 145);
    color: rgb(25, 20, 50);
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("Ithaca-LVB75");
}

.deck-index-btn:hover {
    background-color: var(--color-panel-header-lower);
    color: var(--color-text-accent);
}

.deck-index-btn.active {
    background-color: var(--color-panel-header-upper);
    border-color: var(--color-panel-highlight);
    color: var(--color-text-accent);
}

.card-element {
    width: 42px;
    height: 48px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
}

.card-element.drag-hover {
    overflow: visible;
}

.card-glow {
    display: none;
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    bottom: -1px;
    -unity-background-scale-mode: stretch-to-fill;
    picking-mode: ignore;
}

.card-element.drag-hover .card-glow {
    display: flex;
}

.pool-card {
    margin: 3px 1px;
}

.pool-card.unowned {
    opacity: 0.15;
}

.pool-card.in-deck {
    display: none;
}

.pool-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-self: center;
}

.pool-scroll .unity-scroll-view__content-viewport {
    padding: 0;
    margin: 0;
}

.pool-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
}

.pool-scroll .unity-scroller--vertical {
    width: 7px;
}

.pool-scroll .unity-scroller--vertical .unity-scroller__slider {
    margin: 0 0 4px 0;
    min-width: 0;
}

.pool-scroll .unity-scroller--vertical .unity-base-slider__input {
    margin: 0;
    padding: 0;
}

.pool-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background-image: resource("Menu/slider_back");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-top: 2;
    -unity-slice-bottom: 2;
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    width: 7px;
    margin: 0;
}

.pool-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-image: resource("Menu/slider");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-top: 3;
    -unity-slice-bottom: 3;
    -unity-slice-left: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    left: 0;
    width: 7px;
    height: 21px;
    min-height: 21px;
    max-height: 21px;
    margin: 0;
}

.pool-scroll .unity-repeat-button {
    display: none;
}

.drag-ghost {
    position: absolute;
    width: 34px;
    height: 38px;
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
    opacity: 0.85;
}

.exit-btn {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 33px;
    height: 33px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Menu/exit_button");
    -unity-background-scale-mode: scale-to-fit;
}

.exit-btn:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.exit-btn:active {
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

.card-preview-popup {
    position: absolute;
    width: 96px;
    padding: 3px;
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-panel-border-outer);
    border-radius: 0;
    align-items: center;
}

.card-preview-image {
    width: 88px;
    height: 88px;
    background-color: rgb(12, 12, 20);
    border-width: 1px;
    border-color: var(--color-panel-border-mid);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 2px;
}

.card-preview-name {
    width: 88px;
    height: 8px;
    font-size: 7px;
    -unity-text-align: middle-center;
    color: var(--color-text-accent);
    margin: 0;
    padding: 0;
}

.card-preview-desc {
    width: 88px;
    font-size: 5px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--color-text);
    margin: 1px 0 0 0;
    padding: 0;
}
