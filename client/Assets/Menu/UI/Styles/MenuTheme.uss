:root {
    --color-bar-upper: rgb(96, 97, 124);
    --color-bar-divider: rgb(70, 68, 100);
    --color-bar-lower: rgb(58, 50, 78);
    --color-input-bg: rgb(33, 23, 47);
    --color-text: rgb(200, 200, 210);
    --color-text-accent: rgb(255, 255, 255);

    --color-panel-border-outer: rgb(56, 49, 78);
    --color-panel-border-mid: rgb(69, 67, 100);
    --color-panel-highlight: rgb(120, 118, 150);
    --color-panel-header-upper: rgb(95, 90, 125);
    --color-panel-header-lower: rgb(75, 70, 105);
    --color-panel-bg: var(--color-input-bg);
}

/* Font utilities — fonts live in Assets/Resources */

.u-ithaca      { -unity-font-definition: resource("Ithaca-LVB75"); }

/* Reusable pixel-art beveled panel */

.panel {
    background-color: var(--color-panel-border-outer);
    padding: 1px 2px 2px 2px;
}

.panel-mid {
    background-color: var(--color-panel-border-mid);
    padding: 1px 2px 2px 2px;
    flex-grow: 1;
}

.panel-highlight {
    height: 1px;
    background-color: var(--color-panel-highlight);
}

.panel-header-upper {
    height: 2px;
    background-color: var(--color-panel-header-upper);
}

.panel-header-lower {
    height: 2px;
    background-color: var(--color-panel-header-lower);
}

.panel-body {
    flex-grow: 1;
    background-color: var(--color-panel-bg);
}

/* Settings overlay */

.settings-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
    padding: 20px 0;
}

.settings-panel {
    width: 220px;
    max-height: 100%;
    flex-shrink: 1;
}

.settings-title {
    color: var(--color-text-accent);
    -unity-font-definition: resource("Ithaca-LVB75");
    font-size: 15px;
    -unity-text-align: middle-center;
    padding: 4px 0 2px 0;
}

.settings-divider {
    height: 1px;
    background-color: var(--color-panel-highlight);
    margin: 0 6px;
}

.settings-section-label {
    color: var(--color-panel-highlight);
    -unity-font-definition: resource("Ithaca-LVB75");
    font-size: 9px;
    margin: 4px 6px 1px 6px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 6px;
}

.settings-row-label {
    width: 80px;
    color: var(--color-text);
    -unity-font-definition: resource("Ithaca-LVB75");
    font-size: 10px;
}

.settings-slider {
    flex-grow: 1;
}

.settings-slider .unity-base-slider__input {
    margin: 0;
}

.settings-slider .unity-base-slider__tracker {
    height: 2px;
    background-color: var(--color-bar-lower);
    border-width: 0;
    border-radius: 0;
    margin-top: -1px;
}

.settings-slider .unity-base-slider__dragger {
    width: 5px;
    height: 5px;
    background-color: var(--color-panel-highlight);
    border-width: 0;
    border-radius: 0;
    margin-top: -2px;
}

.settings-toggle-group {
    flex-direction: row;
}

.settings-toggle-btn {
    padding: 1px 5px;
    margin: 0 1px;
    border-width: 1px;
    border-color: var(--color-bar-divider);
    border-radius: 0;
    background-color: var(--color-input-bg);
    color: var(--color-text);
    -unity-font-definition: resource("Ithaca-LVB75");
    font-size: 9px;
}

.settings-toggle-btn.active {
    background-color: var(--color-panel-header-upper);
    color: var(--color-text-accent);
}

.settings-toggle-btn:hover {
    background-color: var(--color-panel-header-lower);
    color: var(--color-text-accent);
}

.settings-buttons {
    flex-direction: row;
    height: 20px;
    margin: 4px 0 0 0;
    padding: 0;
}

.settings-buttons .nav-button {
    -unity-font-definition: resource("Ithaca-LVB75");
    font-size: 11px;
}

.settings-buttons .separator {
    width: 1px;
    align-self: stretch;
    background-color: var(--color-panel-bg);
}
