.progression-root {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0 6px 2px 6px;
    background-image: resource("Menu/background_blue");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.progression-title {
    align-self: center;
    margin-top: 14px;
    height: 22px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    padding: 0;
    letter-spacing: 2px;
}

.bar-area {
    margin-top: 44px;
    margin-left: 36px;
    margin-right: 36px;
    height: 86px;
    justify-content: center;
}

/* ---- Chest row (above the bar) ---- */

.chest-row {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 32px;
}

.chest {
    position: absolute;
    width: 28px;
    height: 32px;
    align-items: center;
    justify-content: flex-end;
}

.chest-glow {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: -2px;
    right: -2px;
    background-color: rgba(255, 205, 85, 0);
    border-radius: 0;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.chest.ready .chest-glow {
    background-color: rgba(255, 205, 85, 0.35);
}

.chest-lid {
    width: 26px;
    height: 9px;
    background-color: rgb(142, 92, 44);
    border-top-width: 2px;
    border-top-color: rgb(200, 140, 72);
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 40, 16);
    border-left-width: 1px;
    border-left-color: rgb(100, 60, 24);
    border-right-width: 1px;
    border-right-color: rgb(100, 60, 24);
}

.chest-body {
    width: 26px;
    height: 17px;
    background-color: rgb(110, 68, 32);
    border-top-width: 1px;
    border-top-color: rgb(160, 100, 52);
    border-bottom-width: 2px;
    border-bottom-color: rgb(50, 26, 8);
    border-left-width: 1px;
    border-left-color: rgb(80, 48, 20);
    border-right-width: 1px;
    border-right-color: rgb(80, 48, 20);
    justify-content: center;
    align-items: center;
}

.chest-band {
    width: 100%;
    height: 1px;
    background-color: rgb(70, 40, 16);
}

.chest-lock {
    width: 7px;
    height: 9px;
    background-color: rgb(210, 170, 60);
    border-top-width: 1px;
    border-top-color: rgb(255, 225, 120);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 80, 20);
    border-left-width: 1px;
    border-left-color: rgb(160, 120, 30);
    border-right-width: 1px;
    border-right-color: rgb(160, 120, 30);
}

/* state: locked — dim gray silhouette */
.chest.locked .chest-lid,
.chest.locked .chest-body {
    background-color: rgb(48, 44, 70);
    border-top-color: rgb(70, 66, 98);
    border-bottom-color: rgb(28, 24, 44);
    border-left-color: rgb(42, 38, 62);
    border-right-color: rgb(42, 38, 62);
}

.chest.locked .chest-lock {
    background-color: rgb(85, 80, 115);
    border-top-color: rgb(115, 110, 145);
    border-bottom-color: rgb(45, 40, 70);
    border-left-color: rgb(70, 66, 98);
    border-right-color: rgb(70, 66, 98);
}

/* state: ready — gold, interactive */
.chest.ready .chest-lock {
    background-color: rgb(255, 215, 90);
    border-top-color: rgb(255, 235, 150);
    border-left-color: rgb(220, 170, 50);
    border-right-color: rgb(220, 170, 50);
}

/* state: claimed — muted green */
.chest.claimed .chest-lid,
.chest.claimed .chest-body {
    background-color: rgb(62, 78, 62);
    border-top-color: rgb(95, 115, 90);
    border-bottom-color: rgb(32, 44, 32);
    border-left-color: rgb(55, 70, 55);
    border-right-color: rgb(55, 70, 55);
}

.chest.claimed .chest-lock {
    background-color: rgb(120, 148, 110);
    border-top-color: rgb(160, 188, 140);
    border-bottom-color: rgb(60, 80, 56);
    border-left-color: rgb(95, 120, 88);
    border-right-color: rgb(95, 120, 88);
}

/* chest becomes a "button" when ready */
.chest-hit {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.chest.ready .chest-hit:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.chest.ready .chest-hit:active {
    background-color: rgba(0, 0, 0, 0.15);
}

/* ---- Progress bar ---- */

.bar-track {
    height: 10px;
    background-color: var(--color-input-bg);
    position: relative;
    overflow: hidden;
}

.bar-track-upper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-bar-lower);
}

.bar-track-lower {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-bar-upper);
}

.bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background-color: rgb(210, 170, 60);
}

.bar-fill-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: rgb(255, 225, 120);
}

.bar-fill-shade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgb(160, 110, 30);
}

.xp-marker {
    position: absolute;
    top: -9px;
    height: 28px;
    width: 2px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    left: 0;
}

.xp-label {
    position: absolute;
    top: -2px;
    min-width: 36px;
    height: 8px;
    font-size: 7px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 1px 3px;
    margin: 0;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

/* ---- Threshold labels (below bar) ---- */

.threshold-row {
    position: absolute;
    top: 44px;
    left: 0;
    right: 0;
    height: 12px;
}

.threshold-label {
    position: absolute;
    min-width: 30px;
    height: 10px;
    font-size: 8px;
    color: rgb(200, 200, 210);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    white-space: nowrap;
}

.threshold-label.reached {
    color: rgb(255, 225, 140);
}

/* ---- Exit button ---- */

.exit-btn {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 33px;
    height: 33px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Menu/exit_button");
    -unity-background-scale-mode: scale-to-fit;
}

.exit-btn:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.exit-btn:active {
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

/* ---- LootBox choice overlay ---- */

.loot-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    justify-content: center;
    align-items: center;
}

.loot-title {
    font-size: 20px;
    color: rgb(255, 225, 140);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 2px;
    padding: 0;
    height: 22px;
}

.loot-card-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.loot-card {
    width: 84px;
    height: 96px;
    margin: 0 8px;
    border-width: 0;
    border-radius: 0;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.15s;
}

.loot-card:hover .loot-card-inner {
    scale: 2.12 2.12;
}

.loot-card:hover {
    translate: 0 -3px;
}

.loot-card:active .loot-card-inner {
    scale: 1.92 1.92;
}

.loot-card-inner {
    scale: 2 2;
    transform-origin: center;
    transition-property: scale;
    transition-duration: 0.15s;
}
