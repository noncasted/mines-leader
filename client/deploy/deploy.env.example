# Copy to ~/.config/mines-leader/deploy.env — credentials for tools/scripts/deploy-webgl.sh.
# Keep it out of the repo.

# SSH target of the Coolify host.
DEPLOY_HOST=root@your-coolify-host

# Host directory bind-mounted into the nginx container (see docker-compose.yaml).
DEPLOY_PATH=/data/mines-leader-web

# Optional: private key to use, if not the ssh-agent default.
# Ignored when tools/scripts/.deploy-password exists — that file switches the
# deploy to password auth via sshpass.
#DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Optional: Unity executable, used by `deploy-webgl.sh --build`.
#UNITY=/home/you/Unity/Hub/Editor/6000.7.0a5/Editor/Unity

# Optional: how many past releases to keep on the server (default 5).
#KEEP_RELEASES=5
